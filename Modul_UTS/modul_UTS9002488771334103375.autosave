  butterflyCache = createGraphics(100, 100);
  renderButterflyToCache(butterflyCache, 40);
}

void movieEvent(Movie m) {
  m.read();
}

void renderButterflyToCache(PGraphics pg, float sz) {
  pg.beginDraw();
  pg.clear();
  pg.pushMatrix();
  pg.translate(pg.width/2, pg.height/2);
  
  color purpleMain = color(200, 100, 255, 160);
  color lightPurple = color(230, 180, 255, 210);
  color highlight = color(255, 255, 255, 230);

  for (int s : new int[]{-1, 1}) {
    pg.pushMatrix();
    pg.scale(s, 1.0);
    pg.stroke(lightPurple);
    pg.strokeWeight(1.5);
    pg.fill(purpleMain);
    pg.beginShape();
    pg.vertex(2, 0);
    pg.bezierVertex(sz * 0.6, -sz * 1.3, sz * 1.6, -sz * 0.9, sz * 1.3, 0);
    pg.bezierVertex(sz * 1.1, sz * 0.5, sz * 0.6, sz * 0.3, 2, 0);
    pg.endShape(CLOSE);
    pg.beginShape();
    pg.vertex(2, 2);
    pg.bezierVertex(sz * 0.9, sz * 0.3, sz * 1.3, sz * 1.1, sz * 0.5, sz * 1.5);
    pg.bezierVertex(sz * 0.2, sz * 1.1, sz * 0.1, sz * 0.6, 2, 2);
    pg.endShape(CLOSE);
    pg.popMatrix();
  }
  pg.fill(highlight, 200);
  pg.noStroke();
  pg.ellipse(0, 0, 4, sz * 0.9);
  pg.popMatrix();
  pg.endDraw();
}

void playSong(int index) {
  if (index >= 0 && index < players.length) {
    if (currentPlayer != null) currentPlayer.pause();
    currentPlayer = players[index];
    if (currentPlayer != null) {
      currentPlayer.rewind();
      currentPlayer.play();
    }
    selectedSong = index;
    smoothProgress = 0; // Reset progress bar untuk lagu baru
    autoNextTriggered = false; // Reset flag setiap kali lagu baru dimulai

    // Handle background video for "About You"
    if (vidioAboutYou != null) {
      if (index == 10) {
        vidioAboutYou.volume(0); // Mute the video
        vidioAboutYou.loop();
        vidioAboutYou.play();
        showVideoAboutYou = false; // Disabled popup
        isPlayingAboutYou = true;
      } else {
        vidioAboutYou.stop();
        showVideoAboutYou = false;
        isPlayingAboutYou = false;
      }
    }

    // Handle background video for "Sempurna"
    if (vidioSempurna != null) {
      if (index == 14) {
        vidioSempurna.volume(0); // Mute the video
        vidioSempurna.loop();
        vidioSempurna.play();
        showVideoSempurna = false; // Disabled popup
        isPlayingSempurna = true;
      } else {
        vidioSempurna.stop();
        showVideoSempurna = false;
        isPlayingSempurna = false;
      }
    }

    // Handle background video for "Monolog"
    if (vidioMonolog != null) {
      if (index == 12) {
        vidioMonolog.volume(0); // Mute the video
        vidioMonolog.loop();
        vidioMonolog.play();
        showVideoMonolog = false; // Background mode, no popup
        isPlayingMonolog = true;
      } else {
        vidioMonolog.stop();
        showVideoMonolog = false;
        isPlayingMonolog = false;
      }
    }

    // Handle background video for "Masa Ini Nanti"
    if (vidioMasaIni != null) {
      if (index == 13) {
        vidioMasaIni.volume(0); // Mute the video
        vidioMasaIni.loop();
        vidioMasaIni.play();
        isPlayingMasaIni = true;
      } else {
        vidioMasaIni.stop();
        isPlayingMasaIni = false;
      }
    }
  }
}

// Panggil ini setiap kali user mulai play dari suatu menu
void setPlayContext(int ctx) {
  playContext = ctx;
}

void nextSong() {
  // Gunakan playContext (dari mana lagu dimulai), bukan currentPage yang berubah
  if (playContext == 1) { // Playlist yang Disukai: lagu 0-4
    selectedSong++;
    if (selectedSong > 4) selectedSong = 0;
  } else if (playContext == 2) { // Lagu Sering Diputar: semua 45 lagu
    selectedSong++;
    if (selectedSong > 44) selectedSong = 0;
  } else if (playContext == 3) { // Album Nisa: 5 lagu per album
    int start = 10 + selectedAlbumIndex * 5;
    int end = start + 4;
    selectedSong++;
    if (selectedSong > end) selectedSong = start;
  } else { // Home / default: semua 45 lagu
    selectedSong = (selectedSong + 1) % players.length;
  }
  playSong(selectedSong);
}

void prevSong() {
  // Gunakan playContext (dari mana lagu dimulai), bukan currentPage yang berubah
  if (playContext == 1) { // Playlist yang Disukai: lagu 0-4
    selectedSong--;
    if (selectedSong < 0) selectedSong = 4;
  } else if (playContext == 2) { // Lagu Sering Diputar: semua 45 lagu
    selectedSong--;
    if (selectedSong < 0) selectedSong = 44;
  } else if (playContext == 3) { // Album Nisa: 5 lagu per album
    int start = 10 + selectedAlbumIndex * 5;
    int end = start + 4;
    selectedSong--;
    if (selectedSong < start) selectedSong = end;
  } else { // Home / default: semua 45 lagu
    selectedSong = (selectedSong - 1 + players.length) % players.length;
  }
  playSong(selectedSong);
}

void draw() {
  if (currentPage == -1) {
    drawSplashScreen();
    return;
  }

  if (currentPage == 9) {
    drawProfileScreen();
    return;
  }

  if (currentPage == 7) {
    drawIPodPlayer();
  } else {
    drawGradientBackground();
    if (currentPage != 6 && currentPage != 7) {
      drawSidebar();
      if (currentPage != 0 && currentPage != 3) drawHeader();
    }

    if (currentPage == 0) {
      drawMainContent();
    } else if (currentPage == 1) {
      drawCategoriesContent();
    } else if (currentPage == 2) {
      drawLibraryContent();
    } else if (currentPage == 3) {
      drawAlbumNisaContent();
    } else if (currentPage == 4) {
      drawAboutYouContent();
    } else if (currentPage == 5) {
      drawFullScreenPlayer();
    } else if (currentPage == 6) {
      drawLyricsScreen();
    } else if (currentPage == 8) {
      drawSearchResultsContent();
    } else if (currentPage == 10) {
      drawKaraukeContent();
    }
  }

  // Animation for UI Offset when music plays
  if (currentPlayer != null && currentPlayer.isPlaying()) {
    uiOffset = lerp(uiOffset, -40, 0.1);
  } else {
    uiOffset = lerp(uiOffset, 0, 0.1);
  }

  // Auto-next logic: play next song when current song finishes
  if (currentPlayer != null && currentPlayer.isPlaying()) {
    autoNextTriggered = false; // Reset flag while song is playing
  }
  if (currentPlayer != null && !currentPlayer.isPlaying() && !autoNextTriggered
    && currentPlayer.position() > 0 && currentPlayer.position() >= currentPlayer.length() - 200) {
    autoNextTriggered = true;
    if (isRepeat) {
      // Mode repeat: putar ulang lagu yang sama
      playSong(selectedSong);
    } else if (isShuffle) {
      // Mode shuffle: pilih lagu acak sesuai konteks
      if (playContext == 1) selectedSong = (int)random(5);
      else if (playContext == 3) {
        int s = 10 + selectedAlbumIndex * 5;
        selectedSong = s + (int)random(5);
      } else selectedSong = (int)random(players.length);
      playSong(selectedSong);
    } else {
      nextSong();
    }
  }

  // Smooth scroll lerp
  homeScrollY = lerp(homeScrollY, targetHomeScrollY, 0.15);
  albumScrollY = lerp(albumScrollY, targetAlbumScrollY, 0.15);
  libScrollY = lerp(libScrollY, targetLibScrollY, 0.15);
  catScrollY = lerp(catScrollY, targetCatScrollY, 0.15);

  // Album open animation
  if (currentPage == 4) {
    albumOpenAnim = lerp(albumOpenAnim, 1.0, 0.1);
  } else {
    albumOpenAnim = 0;
  }

  // Update smooth progress bar
  if (currentPlayer != null && currentPlayer.length() > 0) {
    float targetProgress = (float)currentPlayer.position() / currentPlayer.length();
    // Jika lompatan terlalu jauh (misal pindah lagu), reset langsung
    if (abs(smoothProgress - targetProgress) > 0.1) smoothProgress = targetProgress;
    else smoothProgress = lerp(smoothProgress, targetProgress, 0.1);
  } else {
    smoothProgress = 0;
  }
}

void mouseWheel(MouseEvent event) {
  float e = event.getCount();
  if (currentPage == 0) {
    targetHomeScrollY -= e * 60;
    float maxScroll = - ( (songsList.length / 3) * 260 - (height - 200) );
    if (maxScroll > 0) maxScroll = 0;
    targetHomeScrollY = constrain(targetHomeScrollY, maxScroll, 0);
  } else if (currentPage == 3) {
    targetAlbumScrollY -= e * 60;
    float maxScroll = - ( ceil(albumNames.length / 3.0) * 300 - (height - 200) );
    if (maxScroll > 0) maxScroll = 0;
    targetAlbumScrollY = constrain(targetAlbumScrollY, maxScroll, 0);
  } else if (currentPage == 2) {
    targetLibScrollY -= e * 60;
    float maxScroll = - ( players.length * 65 - (height - 200) );
    if (maxScroll > 0) maxScroll = 0;
    targetLibScrollY = constrain(targetLibScrollY, maxScroll, 0);
  } else if (currentPage == 1) {
    targetCatScrollY -= e * 60;
    float maxScroll = - ( ceil(songsList.length / 3.0) * 370 - (height - 200) );
    if (maxScroll > 0) maxScroll = 0;
    targetCatScrollY = constrain(targetCatScrollY, maxScroll, 0);
  }
}

void mousePressed() {
  int clickTime = millis();
  boolean isDoubleClick = (clickTime - lastClickTime < 300);
  lastClickTime = clickTime;

  // Jika di layar Splash Screen (-1) atau Profil (9), ketuk 2 kali untuk langsung ke beranda
  if (isDoubleClick && (currentPage == -1 || currentPage == 9)) {
    currentPage = 0;
    return;
  }

  if (currentPage == -1) {
    return; // Jangan proses klik lain saat splash screen
  }

  updateControls(mouseX, mouseY);

  if (currentPage == 9) {
    // Tombol Kembali di Profil (kiri atas)
    if (mouseX > 20 && mouseX < 150 && mouseY > 30 && mouseY < 80) {
      currentPage = 0; // Kembali ke Home
    }
    return; // Berhenti agar tidak memproses klik menu lain di background
  }

  // Sidebar Navigation
  if (currentPage != 6 && mouseX > 20 && mouseX < 230) {
    if (mouseY > 95 && mouseY < 135) currentPage = 0;
    else if (mouseY > 145 && mouseY < 185) currentPage = 1;
    else if (mouseY > 195 && mouseY < 235) currentPage = 2;
    else if (mouseY > 245 && mouseY < 285) currentPage = 3;
    else if (mouseY > 290 && mouseY < 325) currentPage = 4;
    else if (mouseY > 345 && mouseY < 385) currentPage = 10; // Karauke
    else if (mouseY > 395 && mouseY < 435 && searchQuery.length() > 0) currentPage = 8; // Search Results


    // Sidebar Mini Player Play Button
    float miniY = height - 95;
    // Play Button
    if (dist(mouseX, mouseY, 200, miniY + 40) < 20) {
      if (currentPlayer != null) {
        if (currentPlayer.isPlaying()) currentPlayer.pause();
        else currentPlayer.play();
      }
    }
    // Clicking Mini Art -> Open Player
    if (mouseX > 10 && mouseX < 240 && mouseY > miniY && mouseY < miniY + 80) {
      currentPage = 7;
    }

    // Clear search when switching pages
    searchFocused = false;
    searchQuery = "";
  }

  // Header Buttons (Top Right)
  float rightOffset = width - 420;
  // Heart Icon -> Liked Playlist
  if (dist(mouseX, mouseY, rightOffset + 30, 52 + uiOffset) < 20) {
    currentPage = 1;
  }
  // Cart Icon
  if (dist(mouseX, mouseY, rightOffset + 90, 52 + uiOffset) < 20) {
    println("Cart clicked!");
  }
  // Profile Picture in Header (Top Right)
  if (dist(mouseX, mouseY, width - 275, 52 + uiOffset) < 20) {
    currentPage = 9;
  }

  // Search Bar Focusing
  if (mouseX > 280 && mouseX < 730 && mouseY > 30 + uiOffset && mouseY < 75 + uiOffset) {
    searchFocused = true;
  } else {
    searchFocused = false;
  }
  // Search Results Page Interaction
  if (currentPage == 8 && mouseX > 280 && mouseX < width - 150) {
    for (int i = 0; i < searchResultIndices.size(); i++) {
      float y = 180 + i * 55;
      if (mouseY > y - 25 && mouseY < y + 30) {
        selectedSong = searchResultIndices.get(i);
        setPlayContext(2); // Anggap semua lagu seperti library
        playSong(selectedSong);
        currentPage = 7; // Go to iPod player
      }
    }
  }

  // 10: Fav Memories Interaction (Sing like a star!)
  if (currentPage == 10) {
    float lx = 300;
    float ly = 180;
    float lw = width - 350;
    float lh = height - 300;

    if (!showVideoMomen) {
      // Toggle based on text click when video is not showing
      float tx_text = lx + lw/2;
      float ty_text = ly + lh - 70;
      if (mouseX > tx_text - 100 && mouseX < tx_text + 100 && mouseY > ty_text - 30 && mouseY < ty_text + 30) {
        showVideoMomen = true;
        if (vidioMomen != null) vidioMomen.loop();
        isPlayingMomen = true;
        showMomenControls = false;
      }
    } else {
      float tx = lx - 20;
      float ty = ly + 40;
      float tw = lw + 40;
      float th = lh - 10;
      float tabW = 250;
      float tabH = 35;

      // Close video button ('x' on tab)
      if (mouseX > tx + tabW - 30 && mouseX < tx + tabW && mouseY > ty - tabH && mouseY < ty) {
        showVideoMomen = false;
        if (vidioMomen != null) vidioMomen.pause();
        isPlayingMomen = false;
        return; // Prevent further processing in this click
      }

      // Video Area Clicks
      float headerH = 50;
      float sbW = 30;
      float cx = tx + 15;
      float cy = ty + headerH + 15;
      float cw = tw - sbW - 30;
      float ch = th - headerH - 30;

      float ctrlW = 350;
      float ctrlH = 80;
      float ctrlX = cx + cw/2 - ctrlW/2;
      float ctrlY = cy + ch - ctrlH - 20;

      if (mouseX > cx && mouseX < cx + cw && mouseY > cy && mouseY < cy + ch) {
        if (showMomenControls && mouseX > ctrlX && mouseX < ctrlX + ctrlW && mouseY > ctrlY && mouseY < ctrlY + ctrlH) {
          // Clicked inside playback controls
          float playBtnX = ctrlX + ctrlW/2;
          // Wider hitbox for the play/pause button (width 80, height 60)
          if (mouseX > playBtnX - 40 && mouseX < playBtnX + 40 && mouseY > ctrlY + 10 && mouseY < ctrlY + 70) {
            // Toggle play/pause
            if (vidioMomen != null) {
              if (isPlayingMomen) {
                vidioMomen.pause();
                isPlayingMomen = false;
              } else {
                vidioMomen.loop(); // use loop() so it continues continuously
                isPlayingMomen = true;
              }
            }
          }
        } else {
          // Clicked outside controls but inside video: toggle controls overlay
          showMomenControls = !showMomenControls;
        }
      }
    }
  }

  // 1: Categories (Liked Playlist) Interaction
  if (currentPage == 1 && mouseX > 280 && mouseX < width - 50) {
    float startX = 280;
    float startY = 130;
    float cardW = 260;
    float cardH = 340;
    float spacing = 30;

    for (int i = 0; i < songsList.length; i++) {
      int col = i % 3;
      int row = i / 3;
      float ax = startX + (cardW + spacing) * col;
      float ay = startY + (cardH + spacing) * row + catScrollY;

      // Play/Pause button in card
      float iconY = ay + cardH - 45;
      if (dist(mouseX, mouseY, ax + cardW/2, iconY) < 25) {
        if (selectedSong == i) {
          if (currentPlayer != null) {
            if (currentPlayer.isPlaying()) currentPlayer.pause();
            else currentPlayer.play();
          }
        } else {
          selectedSong = i;
          setPlayContext(1);
          playSong(selectedSong);
        }
      }

      // Card selection (clicking the art)
      if (mouseX > ax && mouseX < ax + cardW && mouseY > ay && mouseY < ay + cardH - 80) {
        selectedSong = i;
        setPlayContext(1);
        playSong(selectedSong);
        currentPage = 6; // Go to Lyrics
      }
    }
  }
  // Home Page Interaction
  if (currentPage == 0) {
    // Profile Icon (kiri atas konten)
    if (dist(mouseX, mouseY, 300, 60 + uiOffset) < 25) {
      currentPage = 9;
    }

    // Filter Chips
    if (mouseY > 90 && mouseY < 130) {
      if (mouseX > 280 && mouseX < 370) activeFilter = 0;
      else if (mouseX > 380 && mouseX < 470) activeFilter = 1;
    }

    // Search Icon (kanan atas) → buka search
    if (dist(mouseX, mouseY, 1050, 60) < 20) {
      searchFocused = true;
    }
    // Plus Icon (kanan atas) → buka Library
    if (dist(mouseX, mouseY, 1100, 60) < 20) {
      currentPage = 2;
    }

    // Preview panel controls (kanan layar)
    // Koordinat panel preview mengikuti drawLargeAlbumPreview: x=740, y=100+uiOffset*1.5
    float pvX = 740;
    float pvY = 100 + uiOffset * 1.5;
    float ctrlW = 400;
    float ctrlY = pvY + 500;
    float iconY = ctrlY + 50;
    float iconSpacing = ctrlW / 4;

    // Heart / Like toggle
    if (dist(mouseX, mouseY, pvX + ctrlW - 20, ctrlY - 20) < 18) {
      if (selectedSong >= 0 && selectedSong < isLiked.length)
        isLiked[selectedSong] = !isLiked[selectedSong];
    }

    // Progress Bar click (scrubbing)
    if (mouseY > ctrlY - 8 && mouseY < ctrlY + 8
      && mouseX > pvX && mouseX < pvX + ctrlW) {
      if (currentPlayer != null && currentPlayer.length() > 0) {
        int newPos = (int)map(mouseX, pvX, pvX + ctrlW, 0, currentPlayer.length());
        currentPlayer.cue(newPos);
      }
    }

    // Share button (previously shuffle)
    if (dist(mouseX, mouseY, pvX + 10, iconY) < 25) {
      println("Sharing " + songsList[selectedSong]);
    }
    // Prev button
    if (dist(mouseX, mouseY, pvX + iconSpacing, iconY) < 18) {
      prevSong();
    }
    // Play/Pause button (besar)
    if (dist(mouseX, mouseY, pvX + ctrlW/2, iconY) < 28) {
      if (currentPlayer != null) {
        if (currentPlayer.isPlaying()) currentPlayer.pause();
        else currentPlayer.play();
      }
    }
    // Next button
    if (dist(mouseX, mouseY, pvX + ctrlW - iconSpacing, iconY) < 18) {
      if (isShuffle) {
        // Shuffle: pilih lagu acak
        selectedSong = (int)random(players.length);
        setPlayContext(0);
        playSong(selectedSong);
      } else {
        nextSong();
      }
    }
    // Heart / Like button (previously repeat)
    if (dist(mouseX, mouseY, pvX + ctrlW - 10, iconY) < 25) {
      if (selectedSong >= 0 && selectedSong < isLiked.length)
        isLiked[selectedSong] = !isLiked[selectedSong];
    }

    // Song Grid
    float startX = 280;
    float startY = 180;
    float cardW = 250;
    float cardH = 180;
    float spacing = 30;

    float mx = mouseX;
    float my = mouseY - homeScrollY; // Adjust for scroll

    for (int i = 0; i < songsList.length; i++) {
      int col = i % 3;
      int row = i / 3;
      float ax = startX + (cardW + spacing) * col;
      float ay = startY + (cardH + 80) * row;

      // Klik area card (gambar) → play lagu
      if (mx > ax && mx < ax + cardW && my > ay && my < ay + cardH) {
        selectedSong = i % players.length;
        setPlayContext(0); // Home: semua lagu (0-44)
        playSong(selectedSong);
        currentPage = 5;
      }
      // Klik download icon (lingkaran hijau di bawah card)
      if (dist(mx, my, ax + 10, ay + cardH + 60) < 12) {
        // Download icon: toggle like sebagai penanda download
        if (i < isLiked.length) isLiked[i] = !isLiked[i];
      }
    }
  }

  // 3: Album Page Interaction
  if (currentPage == 3) {
    // Profile Icon (kiri atas konten)
    if (dist(mouseX, mouseY, 300, 60 + uiOffset) < 25) {
      currentPage = 9;
    }

    float startX = 280;
    float startY = 180;
    float cardW = 250;
    float cardH = 220; // 220 is the height of the CD card
    float mx = mouseX;
    float my = mouseY - albumScrollY;

    for (int i = 0; i < albumNames.length; i++) { // Loop for all albums
      int col = i % 3;
      int row = i / 3;
      float ax = startX + (col * 280);
      float ay = startY + (row * 300);
      if (mx > ax && mx < ax + cardW && my > ay && my < ay + cardH) {
        selectedAlbumIndex = i; // Save which album was clicked
        currentPage = 4; // Buka menu detail untuk album ini

        int startSong = 10 + selectedAlbumIndex * 5;
        selectedSong = startSong;
        setPlayContext(3); // Album Nisa: 5 lagu per album
        playSong(selectedSong);
      }
    }
  }

  // 4: Album Detail Interaction
  if (currentPage == 4) {
    float startX = 280;
    float startY = 130;
    float w = width - startX - 50;
    float h1 = 280;

    // Back button
    if (mouseX > 280 && mouseX < 370 && mouseY > 80 && mouseY < 110) {
      currentPage = 3;
    }

    // Top Card (Player) Controls
    float ctrlY = startY + 230;
    float cx = startX + 180;
    if (dist(mouseX, mouseY, cx, ctrlY) < 25) {
      if (currentPlayer != null) {
        if (currentPlayer.isPlaying()) currentPlayer.pause();
        else currentPlayer.play();
      }
    }
    if (dist(mouseX, mouseY, startX + 120, ctrlY) < 18) prevSong();
    if (dist(mouseX, mouseY, startX + 240, ctrlY) < 18) nextSong();

    // Clicking art -> Open Lyrics
    if (mouseX > startX + w - 230 && mouseX < startX + w - 30 && mouseY > startY + 30 && mouseY < startY + 230) {
      currentPage = 6;
    }

    // Bottom Card (Song List)
    float listY = startY + h1 + 50;
    int startIdx = 25; // Base index for Java Pride, but generic uses album-specific
    if (selectedAlbumIndex != 3) startIdx = 10 + selectedAlbumIndex * 5;

    for (int i = 0; i < 5; i++) {
      int col = i / 3;
      int row = i % 3;
      float sx = startX + 30 + col * (w/2);
      float sy = listY + 30 + row * 90;
      if (mouseX > sx && mouseX < sx + (w/2) - 50 && mouseY > sy && mouseY < sy + 80) {
        selectedSong = startIdx + i;
        setPlayContext(3);
        playSong(selectedSong);
        currentPage = 6;
      }
    }
  }

  // 6: Lyrics Screen Interaction
  if (currentPage == 6) {
    // Back Button
    if (mouseX > 30 && mouseX < 130 && mouseY > 30 && mouseY < 70) {
      currentPage = 4;
    }

    float leftW = width * 0.45;
    float artSize = (leftW - 100) * 0.7;
    float artX = (leftW - artSize) / 2;
    float artY = 120;
    float cx = artX + artSize/2;
    float ctrlY = artY + artSize + 130;

    // Play/Pause
    if (dist(mouseX, mouseY, cx, ctrlY) < 35) {
      if (currentPlayer != null) {
        if (currentPlayer.isPlaying()) currentPlayer.pause();
        else currentPlayer.play();
      }
    }
    // Shuffle
    if (dist(mouseX, mouseY, cx - 140, ctrlY) < 20) isShuffle = !isShuffle;
    // Repeat
    if (dist(mouseX, mouseY, cx + 140, ctrlY) < 20) isRepeat = !isRepeat;
    // Prev/Next
    if (dist(mouseX, mouseY, cx - 80, ctrlY) < 20) prevSong();
    if (dist(mouseX, mouseY, cx + 80, ctrlY) < 20) nextSong();
  }

  // 2: Library Page (Lagu Sering Diputar) Click
  if (currentPage == 2) {
    float contentX = 280;
    float contentW = width - 350;
    float btnY = 110;
    float btnW = (contentW - 20) / 2;

    float my = mouseY - libScrollY;

    // Play Button Click
    if (mouseX > contentX && mouseX < contentX + btnW && my > btnY && my < btnY + 45) {
      selectedSong = 0;
      setPlayContext(2); // Lagu Sering Diputar: semua 45 lagu
      playSong(selectedSong);
      currentPage = 7;
    }
    // Shuffle Button Click
    else if (mouseX > contentX + btnW + 20 && mouseX < contentX + btnW + 20 + btnW && my > btnY && my < btnY + 45) {
      selectedSong = (int)random(songsList.length);
      setPlayContext(2); // Lagu Sering Diputar: semua 45 lagu
      playSong(selectedSong);
      currentPage = 7;
    }
    // List Click
    else if (mouseX > contentX && mouseX < contentX + contentW && my > 180) { // Below headers/buttons
      for (int i = 0; i < songsList.length; i++) { // Loop for all songs
        float y = 180 + i * 65;
        if (my > y && my < y + 65) {
          selectedSong = i;
          setPlayContext(2); // Lagu Sering Diputar: semua 45 lagu
          playSong(selectedSong);
          currentPage = 7; // Switch to iPod Template
        }
      }
    }
  }

  // 7: iPod Interaction
  if (currentPage == 7) {
    float s = 0.7;
    float centerX = width/2;
    float centerY = height/2;
    float ipodW = 850 * s;
    float ipodH = 480 * s;
    float screenW = 450 * s;
    float screenH = 380 * s;
    float screenX = centerX - ipodW/2 + (35 * s);
    float screenY = centerY - screenH/2;

    // Progress Bar (Scrubbing)
    float barX = screenX + (40 * s);
    float barY = screenY + screenH - (60 * s);
    float barW = screenW - (80 * s);

    if (mouseX > barX && mouseX < barX + barW && mouseY > barY - 15 && mouseY < barY + 15) {
      if (currentPlayer != null) {
        int newPos = (int)map(mouseX, barX, barX + barW, 0, currentPlayer.length());
        currentPlayer.cue(newPos);
      }
    }

    float wheelX = centerX + (230 * s);
    float wheelY = centerY;

    // MENU Button (Back)
    if (dist(mouseX, mouseY, wheelX, wheelY - (110 * s)) < (40 * s)) {
      currentPage = 2;
    }
    // Center Button (Play/Pause)
    if (dist(mouseX, mouseY, wheelX, wheelY) < (50 * s)) {
      if (currentPlayer.isPlaying()) currentPlayer.pause();
      else currentPlayer.play();
    }
    // Bottom Play/Pause Icon area
    if (dist(mouseX, mouseY, wheelX, wheelY + (110 * s)) < (40 * s)) {
      if (currentPlayer.isPlaying()) currentPlayer.pause();
      else currentPlayer.play();
    }
    // Prev
    if (dist(mouseX, mouseY, wheelX - (110 * s), wheelY) < (40 * s)) {
      prevSong();
    }
    // Next
    if (dist(mouseX, mouseY, wheelX + (110 * s), wheelY) < (40 * s)) {
      nextSong();
    }
  }

  // 4: About You Album Page Click
  if (currentPage == 4 && mouseX > 280 && mouseX < width - 50) {
    // Back button click
    if (mouseX > 280 && mouseX < 370 && mouseY > 80 && mouseY < 110) {
      currentPage = 3;
    }

    // All albums in Album Nisa now use template styles
    float x = 280;
    float y = 130;
    float w = width - x - 50;

    // Controls
    float ctrlY = y + 230;
    if (dist(mouseX, mouseY, x + 120, ctrlY) < 25) prevSong();
    if (dist(mouseX, mouseY, x + 180, ctrlY) < 30) {
      if (currentPlayer != null) {
        if (currentPlayer.isPlaying()) currentPlayer.pause();
        else currentPlayer.play();
      }
    }
    if (dist(mouseX, mouseY, x + 240, ctrlY) < 25) nextSong();
    if (dist(mouseX, mouseY, x + 300, ctrlY) < 25) {
      if (selectedSong >= 0 && selectedSong < isLiked.length) {
        isLiked[selectedSong] = !isLiked[selectedSong];
      }
    }
    if (dist(mouseX, mouseY, x + 60, ctrlY) < 25) {
      println("Sharing " + songsList[selectedSong]);
    }

    // Progress Bar Click
    float barY = y + 180;
    float barW = w - 350;
    if (mouseX > x + 30 && mouseX < x + 30 + barW && mouseY > barY - 10 && mouseY < barY + 10) {
      if (currentPlayer != null && currentPlayer.length() > 0) {
        currentPlayer.cue((int)map(mouseX, x + 30, x + 30 + barW, 0, currentPlayer.length()));
      }
    }

    // Song List Clicks
    float listY = y + 280 + 50;
    int startIdx = (selectedAlbumIndex == 3) ? 25 : (10 + selectedAlbumIndex * 5);
    for (int i = 0; i < 5; i++) {
      int col = i / 3;
      int row = i % 3;
      float sx = x + 30 + col * (w/2);
      float sy = listY + 30 + row * 95;
      if (mouseX > sx && mouseX < sx + (w/2) - 50 && mouseY > sy && mouseY < sy + 85) {
        selectedSong = startIdx + i;
        setPlayContext(3);
        playSong(selectedSong);
        // Only go to lyrics if it's NOT Sempurna, to allow popup to show
        if (selectedSong != 14) currentPage = 6;
      }
    }
  }

  // 6: Modern Lyrics Player Controls
  if (currentPage == 6) {
    // Back button
    if (mouseX > 30 && mouseX < 130 && mouseY > 30 && mouseY < 70) {
      currentPage = 4;
    }

    float leftW = width * 0.45;
    float artSize = (leftW - 100) * 0.7;
    float artX = (leftW - artSize) / 2;
    float artY = 120;
    float ctrlY = artY + artSize + 130;

    // Progress Bar Scrubbing
    float barW = artSize;
    if (mouseX > artX && mouseX < artX + barW && mouseY > ctrlY - 65 && mouseY < ctrlY - 45) {
      if (currentPlayer != null && currentPlayer.length() > 0) {
        currentPlayer.cue((int)map(mouseX, artX, artX + barW, 0, currentPlayer.length()));
      }
    }

    // Buttons
    float cx = artX + artSize/2;
    if (dist(mouseX, mouseY, cx, ctrlY) < 35) { // Play/Pause
      if (currentPlayer != null) {
        if (currentPlayer.isPlaying()) currentPlayer.pause();
        else currentPlayer.play();
      }
    } else if (dist(mouseX, mouseY, cx - 80, ctrlY) < 25) { // Prev
      prevSong();
    } else if (dist(mouseX, mouseY, cx + 80, ctrlY) < 25) { // Next
      nextSong();
    } else if (dist(mouseX, mouseY, cx - 140, ctrlY) < 20) { // Shuffle
      isShuffle = !isShuffle;
    } else if (dist(mouseX, mouseY, cx + 140, ctrlY) < 20) { // Repeat
      isRepeat = !isRepeat;
    }

    // Volume Slider
    float volY = ctrlY + 70;
    if (mouseX > artX + 50 && mouseX < artX + artSize - 50 && mouseY > volY - 15 && mouseY < volY + 15) {
      volumeValue = constrain((mouseX - (artX + 50)) / (artSize - 100), 0, 1);
      if (currentPlayer != null) currentPlayer.setGain(map(volumeValue, 0, 1, -40, 10));
    }
  }

  // 5: Template Player Controls
  if (currentPage == 5) {
    float cx = 325 + 450;
    float wy = 150;
    float cy = wy + 30;
    float ctrlY = cy + 220;

    // Play/Pause
    if (dist(mouseX, mouseY, cx + 160, ctrlY) < 30) {
      if (currentPlayer != null) {
        if (currentPlayer.isPlaying()) currentPlayer.pause();
        else currentPlayer.play();
      }
    }
    // Prev
    else if (dist(mouseX, mouseY, cx + 90, ctrlY) < 30) {
      prevSong();
    }
    // Next
    else if (dist(mouseX, mouseY, cx + 230, ctrlY) < 30) {
      nextSong();
    }
  }

  // 5: Interactive Controls Widget (Below Large Preview)
  if (currentPage == 1 || currentPage == 4) {
    float wx = 740;
    float wy = 100 + uiOffset * 1.5 + 500;
    float ww = 400;

    // Play/Pause Circle
    if (dist(mouseX, mouseY, wx + ww/2, wy + 50) < 25) {
      if (currentPlayer != null) {
        if (currentPlayer.isPlaying()) currentPlayer.pause();
        else currentPlayer.play();
      }
    }
    // Prev
    else if (dist(mouseX, mouseY, wx + 100, wy + 50) < 20) {
      prevSong();
    }
    // Next
    else if (dist(mouseX, mouseY, wx + 300, wy + 50) < 20) {
      nextSong();
    }
  }

  // Playback Controls Click (Bottom Bar)
  float barY = height - 45;
  float contentX = 280;
  float contentW = width - 380;
  float centerX = contentX + contentW/2;
  float controlY = barY + 30;
  if (controlY > height - 10) controlY = height - 15;

  if (currentPage != 6 && mouseY > barY) {
    // Play/Pause
    if (dist(mouseX, mouseY, centerX, controlY) < 30) {
      if (currentPlayer != null) {
        if (currentPlayer.isPlaying()) currentPlayer.pause();
        else currentPlayer.play();
      }
    }
    // Previous
    else if (mouseX > centerX - 70 && mouseX < centerX - 30) {
      prevSong();
    }
    // Next
    else if (mouseX > centerX + 30 && mouseX < centerX + 70) {
      nextSong();
    }
  }
}

void drawSidebar() {
  noStroke();
  fill(sidebarColor);
  rect(0, 0, 250, height);
  fill(textColor);
  drawRetroText("playlist nicaa", 30, 40, 28);

  drawMenuItem("Home", 120, currentPage == 0);
  drawMenuItem("Playlist yang Disukai", 170, currentPage == 1);
  drawMenuItem("Lagu Sering Diputar", 220, currentPage == 2);
  drawMenuItem("Album Nisa", 270, currentPage == 3);
  drawMenuItem("fav memories", 360, currentPage == 10);

  if (searchQuery.length() > 0) {
    drawMenuItem("Hasil Cari: " + (searchQuery.length() > 10 ? searchQuery.substring(0, 10)+".." : searchQuery), 410, currentPage == 8);
  }

  // Sub-menu for active album
  if (currentPage == 4) {
    fill(255, 150);
    rect(30, 290, 190, 30, 10);
    fill(accentColor);
  } else {
    fill(textColor);
  }
  textSize(14);
  if (currentPage == 4 && albumNames != null && selectedAlbumIndex < albumNames.length) {
    text("↳ " + albumNames[selectedAlbumIndex], 60, 310);
  } else if (currentPage == 4) {
    text("↳ Album Detail", 60, 310);
  }

  stroke(subTextColor, 50);
  line(30, 460, 220, 460);
  noStroke();

  // Mini Player Glowing Effect
  float miniY = height - 95;
  if (currentPlayer != null && currentPlayer.isPlaying()) {
    fill(accentColor, 30);
    rect(5, miniY - 5, 240, 90, 15);
  }

  fill(255, 120);
  rect(10, miniY, 230, 80, 15);

  PImage miniArt = getSelectedImg();
  if (miniArt != null) image(miniArt, 25, miniY + 15, 50, 50);

  fill(textColor);
  textSize(14);
  if (selectedSong < songsList.length) text(songsList[selectedSong], 85, miniY + 35);
  fill(subTextColor);
  textSize(11);
  if (selectedSong < artistsList.length) text(artistsList[selectedSong], 85, miniY + 55);

  fill(accentColor);
  ellipse(200, miniY + 40, 30, 30);
  fill(255);
  triangle(197, miniY + 32, 197, miniY + 48, 208, miniY + 40);
}

PImage getSelectedImg() {
  if (selectedSong >= 0 && selectedSong < imgsList.length) {
    if (imgsList[selectedSong] != null) {
      return imgsList[selectedSong];
    }
  }
  return song1;
}

void drawMenuItem(String label, float y, boolean active) {
  if (active) {
    fill(255, 150);
    rect(20, y-25, 210, 40, 10);
    fill(accentColor);
  } else {
    fill(textColor);
  }
  textSize(16);
  text(label, 60, y);
}

void drawGradientBackground() {
  // Use the smooth cream-pink gradient for all menus (removed white for page 4)
  if (bgCache != null) {
    image(bgCache, 0, 0);
  } else {
    background(creamColor);
  }
}

void drawHeader() {
  pushMatrix();
  translate(0, uiOffset);

  fill(255, searchFocused ? 180 : 100);
  if (searchFocused) stroke(accentColor);
  else noStroke();
  rect(280, 30, 450, 45, 12);
  noStroke();

  fill(textColor);
  textSize(14);
  if (searchQuery.length() == 0 && !searchFocused) {
    fill(textColor, 150);
    text("Cari lagu, artis, atau album...", 320, 58);
  } else {
    String disp = searchQuery;
    if (searchFocused && (frameCount / 30) % 2 == 0) disp += "|";
    text(disp, 320, 58);
  }

  float rightOffset = width - 420;
  drawIcon(rightOffset + 30, 52, "heart");
  drawIcon(rightOffset + 90, 52, "cart");

  fill(255, 100);
  rect(width - 300, 30, 250, 45, 22);
  fill(textColor);
  textSize(14);
  text("nicayy", width - 250, 50);
  fill(subTextColor);
  textSize(10);
  text("View profile", width - 250, 65);
  if (profileImg != null) {
    image(profileImg, width - 293, 35, 35, 35);
    noFill();
    stroke(accentColor);
    strokeWeight(2);
    ellipse(width - 275, 52, 35, 35);
  }
  popMatrix();
}

void drawIcon(float x, float y, String type) {
  fill(255, 100);
  rect(x-20, y-22, 40, 40, 10);
  stroke(textColor);
  strokeWeight(2);
  noFill();
  if (type.equals("heart")) ellipse(x, y, 15, 15);
  else if (type.equals("cart")) rect(x-8, y-8, 16, 16, 3);
}

void drawMainContent() {
  pushMatrix();
  translate(0, homeScrollY); // Apply scroll

  pushMatrix();
  translate(0, uiOffset);

  // Profile small circle (moved to left like template)
  if (profileImg != null) {
    image(profileImg, 280, 40, 40, 40);
    noFill();
    stroke(accentColor);
    strokeWeight(2);
    ellipse(300, 60, 40, 40);
  }

  // Header section from template
  drawRetroText("Music", 335, 45, 64);

  // Icons at top right
  drawIconSimple(1050, 60, "search");
  drawIconSimple(1100, 60, "plus");

  // Filter Chips
  drawFilterChip("Playlists", 280, 110, activeFilter == 0);
  drawFilterChip("By you", 380, 110, activeFilter == 1);

  popMatrix();

  // Grid of songs
  drawSongGrid();

  popMatrix();
}

void drawFilterChip(String label, float x, float y, boolean active) {
  noStroke();
  if (active) {
    fill(40, 200, 100); // Spotify green
  } else {
    fill(textColor, 40);
  }
  rect(x, y - 18, 90, 32, 16);

  fill(active ? 255 : textColor);
  textSize(13);
  textAlign(CENTER);
  text(label, x + 45, y + 4);
  textAlign(LEFT);
}

void drawHeroMusic() {
  if (song1 != null) image(song1, 0, 0, 800, 300);
  fill(255, 180);
  rect(30, 150, 300, 120, 15);
  fill(textColor);
  textSize(12);
  text("ARTIS UNGGULAN", 50, 180);
  textSize(36);
  text("NISA", 50, 220);
  fill(accentColor);
  rect(50, 230, 100, 30, 15);
  fill(255);
  textAlign(CENTER);
  text("IKUTI", 100, 250);
  textAlign(LEFT);
}

void drawSongGrid() {
  float startX = 280;
  float startY = 180;
  float cardW = 250;
  float cardH = 180;
  float spacing = 30;

  for (int i = 0; i < songsList.length; i++) {
    int col = i % 3;
    int row = i / 3;

    float ax = startX + (cardW + spacing) * col;
    float ay = startY + (cardH + 80) * row;

    // Check if within bounds of window
    if (ay > height - 100) break;

    drawMusicCard(ax, ay, cardW, cardH, songsList[i], artistsList[i], imgsList[i]);
  }
}

void drawMusicCard(float x, float y, float w, float h, String title, String artist, PImage img) {
  // Cassette Style Artwork
  fill(0, 20);
  rect(x - 5, y - 5, w + 10, h + 10, 12); // Shadow/Glow

  if (img != null) {
    image(img, x, y, w, h);
  } else {
    fill(textColor, 20);
    rect(x, y, w, h, 8);
  }

  // Now playing indicator
  boolean isPlayingThis = false;
  if (currentPlayer != null && currentPlayer == players[selectedSong]) {
    // Check if the title in the grid matches the current selection index
    // This is a more robust way than comparing metadata titles
    for (int i = 0; i < songsList.length; i++) {
      if (songsList[i].equals(title) && i == selectedSong) {
        isPlayingThis = true;
        break;
      }
    }
  }

  if (isPlayingThis) {
    fill(accentColor, 150);
    rect(x, y + h - 6, w, 6);
    // Little playing icon
    fill(255);
    rect(x + w - 25, y + 10, 3, 10);
    rect(x + w - 18, y + 5, 3, 15);
    rect(x + w - 11, y + 12, 3, 8);
  }

  // Labels
  fill(textColor);
  textSize(16);
  text(title, x, y + h + 25);

  fill(subTextColor);
  textSize(13);
  text(artist, x, y + h + 45); // Dynamic artist name from artistsList

  // Download icon (small green circle with arrow)
  fill(40, 200, 100);
  ellipse(x + 10, y + h + 60, 18, 18);
  fill(255);
  pushMatrix();
  translate(x + 10, y + h + 60);
  stroke(255);
  strokeWeight(1.5);
  line(0, -4, 0, 4);
  line(-3, 1, 0, 4);
  line(3, 1, 0, 4);
  popMatrix();
}

void drawCategoriesContent() {
  drawRetroText("Liked Playlist", 280, 45, 64);

  pushMatrix();
  translate(0, catScrollY);

  float startX = 280;
  float startY = 130;
  float cardW = 260;
  float cardH = 340;
  float spacing = 30;

  // Background Animated Butterflies
  for (int i = 0; i < 6; i++) {
    float bx = (noise(i * 50, frameCount * 0.002) * (width - 300)) + 280;
    float by = (noise(i * 50 + 20, frameCount * 0.002) * height);
    drawButterfly(bx, by, 20, 0.15);
  }

  // Display all songs in grid
  for (int i = 0; i < songsList.length; i++) {
    int col = i % 3;
    int row = i / 3;
    float ax = startX + (cardW + spacing) * col;
    float ay = startY + (cardH + spacing) * row;

    // Optimization: only draw visible cards
    if (ay + catScrollY + cardH > 0 && ay + catScrollY < height) {
      drawModernMusicCard(ax, ay, cardW, cardH, i);
    }
  }
  popMatrix();
}

void drawModernMusicCard(float x, float y, float w, float h, int sIdx) {
  // Card Body
  fill(255);
  noStroke();
  rect(x, y, w, h, 25);

  // Album Art (Top)
  if (sIdx < imgsList.length && imgsList[sIdx] != null) {
    imageMode(CORNER);
    image(imgsList[sIdx], x + 15, y + 15, w - 30, h - 160);
  }

  // Info
  textAlign(CENTER);
  fill(textColor);
  textFont(titleFont);
  textSize(16);
  text(songsList[sIdx], x + 20, y + h - 120, w - 40, 50);

  fill(subTextColor);
  textFont(mainFont);
  textSize(12);
  text(artistsList[sIdx], x + 20, y + h - 85, w - 40, 30);

  // Progress Bar
  float barY = y + h - 65;
  stroke(textColor, 100);
  strokeWeight(2);
  line(x + 30, barY, x + w - 30, barY);

  if (selectedSong == sIdx && currentPlayer != null) {
    stroke(textColor);
    line(x + 30, barY, x + 30 + (w-60) * smoothProgress, barY);
    fill(textColor);
    noStroke();
    ellipse(x + 30 + (w-60) * smoothProgress, barY, 6, 6);
  }

  // Controls
  float iconY = y + h - 45;
  drawIconSimple(x + w/2 - 50, iconY, "prev");

  fill(textColor);
  ellipse(x + w/2, iconY, 35, 35);
  fill(255);
  if (selectedSong == sIdx && currentPlayer != null && currentPlayer.isPlaying()) {
    rect(x + w/2 - 4, iconY - 6, 3, 12);
    rect(x + w/2 + 1, iconY - 6, 3, 12);
  } else {
    triangle(x + w/2 - 3, iconY - 6, x + w/2 - 3, iconY + 6, x + w/2 + 6, iconY);
  }

  drawIconSimple(x + w/2 + 50, iconY, "next");

  textAlign(LEFT);
}

void drawDynamicLyrics(float x, float y) {
  String[] currentSongLyrics = allLyrics[0];
  if (selectedSong >= 0 && selectedSong < allLyrics.length) {
    currentSongLyrics = allLyrics[selectedSong];
  }

  // Container - Integrated into the preview layout
  fill(0, 40);
  noStroke();
  rect(x-15, y-15, 430, 150, 20); // Premium glass container

  int currentPos = (currentPlayer != null) ? currentPlayer.position() : 0;
  int activeIndex = 0;
  for (int i = 0; i < currentSongLyrics.length; i += 2) {
    if (currentPos >= Integer.parseInt(currentSongLyrics[i])) activeIndex = i;
  }

  // Smooth scroll logic
  targetLyricsScroll = - (activeIndex/2) * 30;
  lyricsScroll = lerp(lyricsScroll, targetLyricsScroll, 0.1);

  pushMatrix();
  translate(x, y + 60 + lyricsScroll); // Center active line

  for (int i = 0; i < currentSongLyrics.length; i += 2) {
    String lyricLine = currentSongLyrics[i+1];
    float ly = (i/2) * 35; // Increased spacing slightly

    // Manual clipping/visibility check for performance and stability
    float screenY = y + 60 + lyricsScroll + ly;
    if (screenY < y - 10 || screenY > y + 140) continue;

    float distance = abs(ly + lyricsScroll);
    float opacity = map(distance, 0, 60, 255, 30);
    float scale = map(distance, 0, 60, 1.2, 0.8);

    if (i == activeIndex) {
      fill(accentColor, opacity);
      textSize(18 * scale);
      text("• " + lyricLine, 10, ly);
    } else {
      fill(textColor, opacity);
      textSize(14 * scale);
      text(lyricLine, 30, ly);
    }
  }
  popMatrix();
}

void drawLargeAlbumPreview(String title, PImage displayImg) {
  float x = 740;
  float y = 100 + uiOffset * 1.5;

  // Album Art or Video Background (For songs 10 and 13 as requested)
  if (selectedSong == 10 && vidioAboutYou != null) {
    image(vidioAboutYou, x, y, 400, 400);
  } else if (selectedSong == 13 && vidioMasaIni != null) {
    image(vidioMasaIni, x, y, 400, 400);
  } else if (displayImg != null) {
    image(displayImg, x, y, 400, 400);
  }

  fill(textColor);
  textSize(24);
  textAlign(CENTER);
  text(title, x + 200, y + 440);
  fill(subTextColor);
  textSize(16);
  text("Nisa", x + 200, y + 465);
  textAlign(LEFT);

  // Reference Image Style Controls below Title
  float ctrlY = y + 500;
  float ctrlW = 400;

  // Heart icon (Top Right of controls)
  drawIconSimple(x + ctrlW - 20, ctrlY - 20, "heart_full");

  // Progress Bar
  stroke(textColor, 50);
  strokeWeight(2);
  line(x, ctrlY, x + ctrlW, ctrlY);

  stroke(textColor);
  line(x, ctrlY, x + ctrlW * smoothProgress, ctrlY);
  fill(textColor);
  ellipse(x + ctrlW * smoothProgress, ctrlY, 10, 10);

  // Timestamps
  fill(subTextColor);
  textSize(10);
  String currentT = "0:00";
  String remainingT = "-0:00";
  if (currentPlayer != null) {
    int pos = currentPlayer.position() / 1000;
    int rem = (currentPlayer.length() - currentPlayer.position()) / 1000;
    currentT = nf(pos/60, 1) + ":" + nf(pos%60, 2);
    remainingT = "-" + nf(rem/60, 1) + ":" + nf(rem%60, 2);
  }
  text(currentT, x, ctrlY + 15);
  textAlign(RIGHT);
  text(remainingT, x + ctrlW, ctrlY + 15);
  textAlign(LEFT);

  // Icons row
  float iconY = ctrlY + 50;
  float spacing = ctrlW / 4;

  drawIconSimple(x + 10, iconY, "share");
  drawIconSimple(x + spacing, iconY, "prev");

  // Big Play/Pause Circle
  fill(255);
  stroke(textColor);
  strokeWeight(2);
  ellipse(x + ctrlW/2, iconY, 60, 60);
  fill(textColor);
  if (currentPlayer != null && currentPlayer.isPlaying()) {
    rect(x + ctrlW/2 - 6, iconY - 10, 4, 20, 2);
    rect(x + ctrlW/2 + 2, iconY - 10, 4, 20, 2);
  } else {
    triangle(x + ctrlW/2 - 4, iconY - 10, x + ctrlW/2 - 4, iconY + 10, x + ctrlW/2 + 10, iconY);
  }

  drawIconSimple(x + ctrlW - spacing, iconY, "next");
  drawIconSimple(x + ctrlW - 10, iconY, "heart_full");

  // Lirik Muncul Dibawah Tombol Play
  if (currentPlayer != null && (currentPlayer.isPlaying() || currentPlayer.position() > 0)) {
    drawDynamicLyrics(x, iconY + 40);
  }
}

void drawIconSimple(float x, float y, String type) {
  pushMatrix();
  translate(x, y);
  stroke(textColor);
  strokeWeight(1.5);
  noFill();

  if (type.equals("heart_full")) {
    boolean liked = (selectedSong >= 0 && selectedSong < isLiked.length) ? isLiked[selectedSong] : false;
    fill(liked ? #FF4B4B : textColor);
    noStroke();
    beginShape();
    vertex(0, 5);
    bezierVertex(-10, -5, -15, -15, 0, -5);
    bezierVertex(15, -15, 10, -5, 0, 5);
    endShape(CLOSE);
  } else if (type.equals("shuffle")) {
    // Hijau kalau aktif, biasa kalau tidak
    if (isShuffle) stroke(40, 200, 100);
    else stroke(textColor);
    line(-8, -5, 8, 5);
    line(-8, 5, -2, 1);
    line(2, -1, 8, -5);
    triangle(8, 5, 4, 3, 6, 7);
    triangle(8, -5, 4, -7, 6, -3);
    if (isShuffle) {
      fill(40, 200, 100);
      noStroke();
      ellipse(0, 8, 4, 4);
    } // dot indicator
  } else if (type.equals("prev")) {
    fill(textColor);
    noStroke();
    triangle(4, -7, 4, 7, -4, 0);
    rect(-6, -7, 2, 14);
  } else if (type.equals("next")) {
    fill(textColor);
    noStroke();
    triangle(-4, -7, -4, 7, 4, 0);
    rect(4, -7, 2, 14);
  } else if (type.equals("repeat")) {
    // Hijau kalau aktif
    if (isRepeat) stroke(40, 200, 100);
    else stroke(textColor);
    noFill();
    arc(0, 0, 16, 12, -PI, PI/2);
    line(8, 0, 8, -4);
    if (isRepeat) fill(40, 200, 100);
    else fill(textColor);
    noStroke();
    triangle(0, 6, -3, 3, 3, 3);
    if (isRepeat) {
      fill(40, 200, 100);
      ellipse(0, -8, 4, 4);
    } // dot indicator
  } else if (type.equals("search")) {
    noFill();
    stroke(textColor);
    strokeWeight(2);
    ellipse(-2, -2, 12, 12);
    line(4, 4, 8, 8);
  } else if (type.equals("plus")) {
    stroke(textColor);
    strokeWeight(2);
    line(-8, 0, 8, 0);
    line(0, -8, 0, 8);
  } else if (type.equals("share")) {
    stroke(textColor);
    strokeWeight(1.5);
    noFill();
    ellipse(-6, 0, 6, 6);
    ellipse(6, -6, 6, 6);
    ellipse(6, 6, 6, 6);
    line(-3, 0, 3, -4);
    line(-3, 0, 3, 4);
  }
  popMatrix();
}

void drawDetailedPlayback(String title) {
  float barY = height - 45;
  float contentX = 280;
  float contentW = width - 380;

  // Progress Bar - Linked to real MP3
  float progress = 0;
  String currentT = "0:00";
  String totalT = "0:00";

  if (currentPlayer != null && currentPlayer.length() > 0) {
    progress = (float)currentPlayer.position() / currentPlayer.length();
    int pos = currentPlayer.position() / 1000;
    int len = currentPlayer.length() / 1000;
    currentT = nf(pos/60, 1) + ":" + nf(pos%60, 2);
    totalT = nf(len/60, 1) + ":" + nf(len%60, 2);
  }

  stroke(subTextColor, 100);
  strokeWeight(3);
  line(contentX, barY, contentX + contentW, barY);
  stroke(accentColor);
  line(contentX, barY, contentX + contentW * smoothProgress, barY);

  fill(subTextColor);
  textSize(11);
  text(currentT, contentX - 35, barY + 5);
  text(totalT, contentX + contentW + 15, barY + 5);

  float centerX = contentX + contentW/2;
  float controlY = barY + 30;
  // Make sure controlY doesn't go off screen if height is small
  if (controlY > height - 10) controlY = height - 15;

  // Playback buttons removed as requested

  fill(textColor);
  textSize(14);
  text(title, contentX, controlY);
  fill(subTextColor);
  textSize(11);
  if (selectedSong < artistsList.length) text(artistsList[selectedSong], contentX, controlY + 15);

  // Volume slider at far right
  float volX = contentX + contentW - 60;
  stroke(textColor);
  strokeWeight(2);
  noFill();
  rect(volX, controlY - 5, 60, 10, 5);
  fill(accentColor);
  rect(volX, controlY - 5, 60 * volumeValue, 10, 5);
}

void drawLibraryContent() {
  float contentX = 280;
  float contentW = width - 350;

  pushMatrix();
  translate(0, libScrollY);

  textFont(mainFont);

  // Buttons
  float btnY = 110;
  float btnW = (contentW - 20) / 2;

  // Play Button
  fill(240, 240, 245);
  noStroke();
  rect(contentX, btnY, btnW, 45, 10);
  fill(250, 50, 80); // Red
  triangle(contentX + btnW/2 - 25, btnY + 15, contentX + btnW/2 - 25, btnY + 30, contentX + btnW/2 - 12, btnY + 22.5);
  textSize(18);
  text("Play", contentX + btnW/2 - 2, btnY + 14);

  // Shuffle Button
  fill(240, 240, 245);
  rect(contentX + btnW + 20, btnY, btnW, 45, 10);
  fill(250, 50, 80);
  // Simple shuffle icon representation
  stroke(250, 50, 80);
  strokeWeight(2);
  noFill();
  line(contentX + btnW + 20 + btnW/2 - 35, btnY + 18, contentX + btnW + 20 + btnW/2 - 25, btnY + 28);
  line(contentX + btnW + 20 + btnW/2 - 35, btnY + 28, contentX + btnW + 20 + btnW/2 - 25, btnY + 18);
  triangle(contentX + btnW + 20 + btnW/2 - 25, btnY + 28, contentX + btnW + 20 + btnW/2 - 28, btnY + 24, contentX + btnW + 20 + btnW/2 - 22, btnY + 24);
  noStroke();
  fill(250, 50, 80);
  textSize(18);
  text("Shuffle", contentX + btnW + 20 + btnW/2 - 15, btnY + 14);

  float startY = 180;
  float rowH = 65;

  for (int i = 0; i < songsList.length; i++) {
    float y = startY + i * rowH;

    // Separator (only between items, not top/bottom)
    if (i > 0) {
      stroke(230, 230, 230, 100);
      strokeWeight(1);
      line(contentX + 50, y, contentX + contentW, y);
    }

    noStroke();

    // Highlight if selected (subtle)
    if (i == selectedSong) {
      fill(250, 50, 80, 20);
      rect(contentX - 10, y, contentX + contentW - contentX + 20, rowH, 8);
    }

    // Star
    fill(250, 50, 80);
    drawStar(contentX + 10, y + 32, 4, 8, 5);

    // Art (45x45)
    if (i < imgsList.length && imgsList[i] != null) {
      image(imgsList[i], contentX + 30, y + 10, 45, 45);
    }

    // Texts
    fill(textColor);
    textSize(16);
    String title = (i < songsList.length) ? songsList[i] : "Unknown";
    text(title, contentX + 85, y + 16);

    fill(subTextColor);
    textSize(13);
    String artist = (i < artistsList.length) ? artistsList[i] : "Unknown";
    text(artist, contentX + 85, y + 36);

    // Icons on right
    float rightX = contentX + contentW;
    // Download icon
    noFill();
    stroke(subTextColor, 150);
    strokeWeight(1.5);
    ellipse(rightX - 45, y + 32, 20, 20);
    line(rightX - 45, y + 26, rightX - 45, y + 36);
    line(rightX - 49, y + 32, rightX - 45, y + 36);
    line(rightX - 41, y + 32, rightX - 45, y + 36);

    // Ellipsis
    fill(subTextColor, 150);
    noStroke();
    ellipse(rightX - 15, y + 32, 3, 3);
    ellipse(rightX - 8, y + 32, 3, 3);
    ellipse(rightX - 1, y + 32, 3, 3);
  }
  popMatrix();
}

void drawAlbumNisaContent() {
  pushMatrix();
  translate(0, albumScrollY);

  pushMatrix();
  translate(0, uiOffset);

  // Profile small circle (moved to left like template)
  if (profileImg != null) {
    image(profileImg, 280, 40, 40, 40);
    noFill();
    stroke(accentColor);
    strokeWeight(2);
    ellipse(300, 60, 40, 40);
  }

  // Header section
  // Header section
  drawRetroText("Music", 335, 45, 64);

  // Icons at top right
  drawIconSimple(1050, 60, "search");
  drawIconSimple(1100, 60, "plus");

  // Filter Chips
  drawFilterChip("Playlists", 280, 110, activeFilter == 0);
  drawFilterChip("By you", 380, 110, activeFilter == 1);

  popMatrix();

  // Grid of albums (CD Style)
  float x = 280;
