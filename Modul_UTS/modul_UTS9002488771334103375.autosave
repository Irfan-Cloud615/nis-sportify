    float ax = x + (col * 280);
    float ay = y + (row * 300);

    drawCDCard(ax, ay, 250, 220, albumNames[i], albumCovers[i]);
  }

  popMatrix();
}

void drawAboutYouContent() {
  if (selectedAlbumIndex == 3) {
    drawJawaPrideTemplate();
    return;
  }
  // Use generic template for all other albums (About You, Mood Shif, Playlist Nica, etc.)
  drawGenericAlbumTemplate();
}

void drawJawaPrideTemplate() {
  pushMatrix();
  float yOffset = (1.0 - albumOpenAnim) * 50;
  translate(0, yOffset);

  // Background Decorations
  for (int i = 0; i < 5; i++) {
    fill(255, 100, 150, 100);
    drawStar(300 + i*200, 100 + (i%2)*100, 5, 12, 4);
  }

  // Header "Hear Our Voices Blog Tour"
  fill(textColor);
  textSize(14);
  textAlign(RIGHT);
  text("Hear Our Voices Blog Tour", width - 50, 60);
  textAlign(LEFT);

  // Back button
  fill(255, 150);
  rect(280, 80, 90, 30, 15);
  fill(textColor);
  textSize(12);
  text("< Kembali", 295, 100);

  float x = 280;
  float y = 130;
  float w = width - x - 50;
  float h1 = 280;

  // --- TOP CARD: Player ---
  drawTemplateCard(x, y, w, h1);

  // Player Content
  fill(textColor);
  textSize(14);
  text("It's You Every Time", x + 30, y + 40);
  text("Playlist", x + 30, y + 60);

  float leftW = w - 260;
  textAlign(CENTER);
  if (bubblyFont != null) textFont(bubblyFont);
  textSize(38);
  text(songsList[selectedSong], x + 30, y + 80, leftW, 100);

  textFont(mainFont);
  textSize(18);
  text(artistsList[selectedSong], x + 30 + leftW/2, y + 150);
  textAlign(LEFT);

  // Duration
  textAlign(RIGHT);
  int totalSec = (currentPlayer != null) ? currentPlayer.length() / 1000 : 0;
  String totalT = nf(totalSec/60, 1) + ":" + nf(totalSec%60, 2);
  text(totalT, x + w - 300, y + 150);
  textAlign(LEFT);

  // Progress Bar
  float barY = y + 180;
  float barW = w - 350;
  stroke(textColor);
  strokeWeight(2);
  line(x + 30, barY, x + 30 + barW, barY);
  fill(textColor);
  ellipse(x + 30 + barW * smoothProgress, barY, 10, 10);

  // Controls
  float ctrlY = y + 230;
  drawIconSimple(x + 60, ctrlY, "share");
  drawIconSimple(x + 120, ctrlY, "prev");

  // Play/Pause Circle
  fill(255);
  stroke(textColor);
  strokeWeight(2);
  ellipse(x + 180, ctrlY, 60, 60);
  fill(textColor);
  if (currentPlayer != null && currentPlayer.isPlaying()) {
    rect(x + 180 - 6, ctrlY - 10, 4, 20, 2);
    rect(x + 180 + 2, ctrlY - 10, 4, 20, 2);
  } else {
    triangle(x + 180 - 4, ctrlY - 10, x + 180 - 4, ctrlY + 10, x + 180 + 10, ctrlY);
  }

  drawIconSimple(x + 240, ctrlY, "next");
  drawIconSimple(x + 300, ctrlY, "heart_full");

  // Album Art or Video (For songs 10 and 13 as requested)
  if (selectedSong == 10 && vidioAboutYou != null) {
    image(vidioAboutYou, x + w - 230, y + 30, 200, 200);
  } else if (selectedSong == 13 && vidioMasaIni != null) {
    image(vidioMasaIni, x + w - 230, y + 30, 200, 200);
  } else if (imgsList[selectedSong] != null) {
    image(imgsList[selectedSong], x + w - 230, y + 30, 200, 200);
  }

  // Art Border
  noFill();
  stroke(textColor, 40);
  rect(x + w - 230, y + 30, 200, 200, 15);

  // --- BOTTOM CARD: Song List ---
  y += h1 + 50;
  float h2 = 320;
  drawTemplateCard(x, y, w, h2);

  // 2-Column Song List (Indices 25-29)
  int startSong = 25;
  for (int i = 0; i < 5; i++) {
    int sIdx = startSong + i;
    int col = i / 3;
    int row = i % 3;
    float sx = x + 30 + col * (w/2);
    float sy = y + 30 + row * 90;

    // Song Item
    if (sIdx < songsList.length) {
      // Small Thumb
      if (imgsList[sIdx] != null) {
        image(imgsList[sIdx], sx, sy, 70, 70);
      } else {
        fill(textColor, 20);
        rect(sx, sy, 70, 70, 8);
      }
      noFill();
      stroke(textColor, 30);
      rect(sx, sy, 70, 70, 8);

      // Texts
      fill(textColor);
      textSize(16);
      textFont(titleFont);
      text(songsList[sIdx], sx + 85, sy + 15, (w/2) - 180, 50);

      fill(subTextColor);
      textSize(12);
      textFont(mainFont);
      text(artistsList[sIdx], sx + 85, sy + 45);

      // Heart Icon
      drawIconSimple(sx + (w/2) - 80, sy + 35, "heart_full");
    }
  }

  popMatrix();
}

void drawTemplateCard(float x, float y, float w, float h) {
  pushStyle();
  // Depth layers
  noStroke();
  fill(100, 80, 200); // Purple bottom
  rect(x + 6, y + 10, w, h, 30);
  fill(255, 100, 150); // Pink middle
  rect(x + 3, y + 5, w, h, 30);

  // Main Card
  stroke(textColor);
  strokeWeight(2);
  fill(255);
  rect(x, y, w, h, 30);
  popStyle();
}

void drawGenericAlbumTemplate() {
  pushMatrix();
  float yOffset = (1.0 - albumOpenAnim) * 50;
  translate(0, yOffset);

  // Background Animated Butterflies
  for (int i = 0; i < 4; i++) {
    float bx = (noise(i * 30, frameCount * 0.004) * (width - 300)) + 280;
    float by = (noise(i * 30 + 10, frameCount * 0.004) * height);
    drawButterfly(bx, by, 18, 0.2);
  }

  // Header
  fill(textColor);
  textSize(14);
  textAlign(LEFT);
  text("Nisa's Premium Collection", 280, 60);

  // Back button
  fill(255, 180);
  noStroke();
  rect(280, 80, 90, 30, 15);
  fill(textColor);
  textSize(12);
  text("< Kembali", 295, 100);

  float x = 280;
  float y = 130;
  float w = width - x - 50;
  float h1 = 280;

  // --- TOP CARD: Player ---
  drawTemplateCard(x, y, w, h1);

  // Content
  fill(subTextColor);
  textSize(13);
  text("Album: " + albumNames[selectedAlbumIndex], x + 30, y + 50);
  stroke(textColor, 100);
  line(x + 180, y + 46, x + 330, y + 46);

  fill(textColor);
  textFont(titleFont);
  textSize(38);
  text(songsList[selectedSong], x + 30, y + 80, w - 350, 100);

  textFont(mainFont);
  textSize(16);
  if (selectedSong < artistsList.length) text(artistsList[selectedSong], x + 30, y + 150);

  textAlign(RIGHT);
  int totalSec = (currentPlayer != null) ? currentPlayer.length() / 1000 : 0;
  String totalT = nf(totalSec/60, 1) + ":" + nf(totalSec%60, 2);
  text(totalT, x + w - 300, y + 150);
  textAlign(LEFT);

  // Progress Bar
  float barY = y + 180;
  float barW = w - 350;
  stroke(textColor);
  strokeWeight(2);
  line(x + 30, barY, x + 30 + barW, barY);
  fill(textColor);
  ellipse(x + 30 + barW * smoothProgress, barY, 10, 10);

  // Controls
  float ctrlY = y + 230;
  drawIconSimple(x + 60, ctrlY, "share");
  drawIconSimple(x + 120, ctrlY, "prev");

  // Play/Pause Circle
  fill(255);
  stroke(textColor);
  strokeWeight(2);
  ellipse(x + 180, ctrlY, 60, 60);
  fill(textColor);
  if (currentPlayer != null && currentPlayer.isPlaying()) {
    rect(x + 180 - 6, ctrlY - 10, 4, 20, 2);
    rect(x + 180 + 2, ctrlY - 10, 4, 20, 2);
  } else {
    triangle(x + 180 - 4, ctrlY - 10, x + 180 - 4, ctrlY + 10, x + 180 + 10, ctrlY);
  }

  drawIconSimple(x + 240, ctrlY, "next");
  drawIconSimple(x + 300, ctrlY, "heart_full");

  // Art or Video (For songs 10 and 13)
  if (selectedSong == 10 && vidioAboutYou != null) {
    image(vidioAboutYou, x + w - 320, y + 35, 290, 210);
  } else if (selectedSong == 13 && vidioMasaIni != null) {
    image(vidioMasaIni, x + w - 320, y + 35, 290, 210);
  } else if (imgsList[selectedSong] != null) {
    image(imgsList[selectedSong], x + w - 320, y + 35, 290, 210);
  }

  // Border for Art/Video
  if (selectedSong == 10 || selectedSong == 14 || selectedSong == 12 || selectedSong == 13 || imgsList[selectedSong] != null) {
    noFill();
    stroke(textColor, 40);
    rect(x + w - 320, y + 35, 290, 210, 20);
  }

  // --- BOTTOM CARD: List ---
  y += h1 + 50;
  float h2 = 330;
  drawTemplateCard(x, y, w, h2);

  int startSong = 10 + selectedAlbumIndex * 5;
  for (int i = 0; i < 5; i++) {
    int sIdx = startSong + i;
    int col = i / 3;
    int row = i % 3;
    float sx = x + 30 + col * (w/2);
    float sy = y + 30 + row * 95;

    if (sIdx < songsList.length) {
      if (imgsList[sIdx] != null) {
        image(imgsList[sIdx], sx, sy, 85, 85);
      } else {
        fill(textColor, 20);
        rect(sx, sy, 85, 85, 12);
      }
      noFill();
      stroke(textColor, 30);
      rect(sx, sy, 85, 85, 12);

      fill(textColor);
      textSize(17);
      textFont(titleFont);
      text(songsList[sIdx], sx + 100, sy + 20, (w/2) - 200, 50);

      fill(subTextColor);
      textSize(12);
      textFont(mainFont);
      if (sIdx < artistsList.length) text(artistsList[sIdx], sx + 100, sy + 55);

      drawIconSimple(sx + (w/2) - 80, sy + 40, "heart_full");
    }
  }

  popMatrix();
}

void drawVideoPopup(float lx, float ly, float lw, float lh, Movie vid, String title) {
  pushStyle();
  float tx = lx - 20;
  float ty = ly + 40;
  float tw = lw + 40;
  float th = lh - 10;

  color bgPink = color(251, 228, 228);
  color tabPink = color(214, 162, 162);
  color darkOutline = color(50, 20, 20);
  color fillDarkPink = color(232, 197, 197);

  // 1. BACK WINDOW
  float bx = tx + tw - 50;
  float by = ty - 60;
  float bw = 150;
  float bh = th + 40;
  stroke(darkOutline);
  strokeWeight(3);
  fill(bgPink);
  rect(bx, by, bw, bh, 5);
  line(bx, by + 35, bx + bw, by + 35);
  fill(bgPink);
  ellipse(bx + bw - 20, by + 17, 10, 10);
  ellipse(bx + bw - 40, by + 17, 10, 10);

  // 2. FRONT WINDOW
  float tabW = 250;
  float tabH = 35;
  stroke(darkOutline);
  strokeWeight(3);
  fill(bgPink);
  rect(tx, ty, tw, th, 5);

  // Header
  float headerH = 50;
  fill(tabPink);
  rect(tx + 2, ty + 2, tw - 4, headerH - 12, 5, 5, 0, 0);
  line(tx, ty + headerH, tx + tw, ty + headerH);

  // Address pill
  fill(fillDarkPink);
  rect(tx + 65, ty + 5, tw - 130, 28, 14);
  fill(darkOutline);
  textSize(12);
  textAlign(CENTER, CENTER);
  text(title, tx + tw/2, ty + 19);

  // Tab
  fill(bgPink);
  stroke(darkOutline);
  beginShape();
  vertex(tx, ty + 2);
  vertex(tx, ty - tabH);
  quadraticVertex(tx, ty - tabH - 5, tx + 5, ty - tabH - 5);
  vertex(tx + tabW - 20, ty - tabH - 5);
  quadraticVertex(tx + tabW, ty - tabH - 5, tx + tabW + 5, ty + 2);
  endShape(CLOSE);

  // 'x' on tab
  line(tx + tabW - 20, ty - tabH + 12, tx + tabW - 10, ty - tabH + 22);
  line(tx + tabW - 10, ty - tabH + 12, tx + tabW - 20, ty - tabH + 22);

  // Video Area
  float cx = tx + 15;
  float cy = ty + headerH + 15;
  float cw = tw - 60;
  float ch = th - headerH - 30;

  if (vid.width > 0) {
    image(vid, cx, cy, cw, ch);
    noFill();
    stroke(darkOutline);
    rect(cx, cy, cw, ch);
  }
  popStyle();
}

void drawCDCard(float x, float y, float w, float h, String title, PImage img) {
  // Clear CD Case Rendering
  noStroke();
  fill(255, 40); // Plastic shine
  rect(x, y, w, w, 15);

  // Case Borders (Acrylic look)
  stroke(255, 80);
  strokeWeight(2);
  noFill();
  rect(x + 2, y + 2, w - 4, w - 4, 12);

  // Inner Disc (Circle)
  if (img != null) {
    // Masked-like disc
    pushMatrix();
    translate(x + w/2, y + w/2);
    noStroke();
    fill(0, 30);
    ellipse(0, 0, w - 20, w - 20); // Shadow

    // The Disc Surface
    fill(255);
    ellipse(0, 0, w - 25, w - 25);

    // Mini Album Art on Disc
    imageMode(CENTER);
    image(img, 0, 0, w - 30, w - 30); // Placeholder for actual masked circle
    imageMode(CORNER);

    // Spindle removed as requested
    popMatrix();
  }

  // Labels
  fill(textColor);
  textSize(16);
  text(title, x, y + w + 25);

  fill(subTextColor);
  textSize(13);
  text("mee3", x, y + w + 45); // Artist as seen in template
}

void drawStat(String label, String value, float x, float y) {
  // Function no longer used
}

void drawFullScreenPlayer() {
  float ww = 800;
  float wh = 450;
  float wx = 250 + (width - 250 - ww)/2;
  float wy = (height - wh)/2;

  fill(15, 15, 15);
  noStroke();
  rect(wx, wy, ww, wh, 40);

  // Album Art or Video
  if (selectedSong == 10 && vidioAboutYou != null) {
    image(vidioAboutYou, wx + 30, wy + 30, 390, 390);
  } else if (selectedSong == 13 && vidioMasaIni != null) {
    image(vidioMasaIni, wx + 30, wy + 30, 390, 390);
  } else {
    PImage img = getSelectedImg();
    if (img != null) {
      image(img, wx + 30, wy + 30, 390, 390);
    }
  }

  float cx = wx + 450; // Controls start X
  float cy = wy + 30;  // Controls start Y

  // Top right text
  fill(150);
  textSize(14);
  text("iPhone", cx, cy + 15);

  // Title and Artist
  fill(255);
  textSize(28);
  textFont(titleFont);
  text(songsList[selectedSong], cx, cy + 50);

  // E icon (Explicit)
  float tw = textWidth(songsList[selectedSong]);
  fill(200);
  rect(cx + tw + 10, cy + 30, 18, 18, 4);
  fill(15);
  textSize(12);
  textFont(mainFont);
  text("E", cx + tw + 15, cy + 44);

  fill(180);
  textSize(20);
  textFont(mainFont);
  text("Nisa", cx, cy + 85);

  // Timeline
  float progress = 0;
  String currentT = "0:00";
  String remainingT = "-0:00";
  if (currentPlayer != null && currentPlayer.length() > 0) {
    progress = (float)currentPlayer.position() / currentPlayer.length();
    int pos = currentPlayer.position() / 1000;
    int rem = (currentPlayer.length() - currentPlayer.position()) / 1000;
    currentT = nf(pos/60, 1) + ":" + nf(pos%60, 2);
    remainingT = "-" + nf(rem/60, 1) + ":" + nf(rem%60, 2);
  }

  float barY = cy + 140;
  fill(150);
  textSize(14);
  text(currentT, cx, barY + 5);
  text(remainingT, cx + 280, barY + 5);

  stroke(80);
  strokeWeight(4);
  strokeCap(ROUND);
  line(cx + 40, barY, cx + 270, barY);
  stroke(200);
  line(cx + 40, barY, cx + 40 + 230 * smoothProgress, barY);

  // Controls
  float ctrlY = cy + 220;

  drawPlayerIcon(cx + 15, ctrlY, "star");
  drawPlayerIcon(cx + 90, ctrlY, "prev_fill");
  drawPlayerIcon(cx + 160, ctrlY, currentPlayer != null && currentPlayer.isPlaying() ? "pause_fill" : "play_fill");
  drawPlayerIcon(cx + 230, ctrlY, "next_fill");
  drawPlayerIcon(cx + 300, ctrlY, "airplay");

  // Volume bar at bottom
  float volY = wy + 390;
  drawPlayerIcon(cx + 5, volY, "vol_down");
  stroke(80);
  strokeWeight(4);
  strokeCap(ROUND);
  line(cx + 30, volY, cx + 280, volY);
  stroke(200);
  line(cx + 30, volY, cx + 180, volY); // Hardcoded volume level
  drawPlayerIcon(cx + 300, volY, "vol_up");
}

void drawLyricsPlayer() {
  for (int i = 0; i <= height; i++) {
    float inter = map(i, 0, height, 0, 1);
    color c = lerpColor(color(60, 15, 15), color(10, 5, 5), inter);
    stroke(c);
    line(0, i, width, i);
  }

  fill(255, 150);
  textSize(16);
  textFont(mainFont);
  text("< Kembali", 40, 50);

  float artSize = min(400, height * 0.5);
  float artX = 100;
  float artY = (height - artSize - 150) / 2 + 50;

  noStroke();
  fill(0, 80);
  rect(artX - 10, artY - 10, 420, 420, 20);

  PImage img = getSelectedImg();
  if (img != null) {
    image(img, artX, artY, 400, 400);
  } else {
    fill(40);
    rect(artX, artY, 400, 400, 15);
  }

  fill(255);
  textSize(28);
  textFont(titleFont);
  text(songsList[selectedSong], artX, artY + 460);
  fill(180);
  textSize(18);
  textFont(mainFont);
  text("Nisa", artX, artY + 490);

  float progress = 0;
  String currentT = "0:00";
  String remainingT = "-0:00";
  if (currentPlayer != null && currentPlayer.length() > 0) {
    progress = (float)currentPlayer.position() / currentPlayer.length();
    int pos = currentPlayer.position() / 1000;
    int rem = (currentPlayer.length() - currentPlayer.position()) / 1000;
    currentT = nf(pos/60, 1) + ":" + nf(pos%60, 2);
    remainingT = "-" + nf(rem/60, 1) + ":" + nf(rem%60, 2);
  }

  float barY = artY + 540;
  stroke(80);
  strokeWeight(4);
  strokeCap(ROUND);
  line(artX, barY, artX + 400, barY);
  stroke(255);
  line(artX, barY, artX + 400 * smoothProgress, barY);

  fill(150);
  textSize(12);
  text(currentT, artX, barY + 20);
  textAlign(RIGHT);
  text(remainingT, artX + 400, barY + 20);
  textAlign(LEFT);

  float ctrlY = barY + 60;
  drawPlayerIcon(artX + 20, ctrlY, "shuffle");
  drawPlayerIcon(artX + 110, ctrlY, "prev_fill");
  drawPlayerIcon(artX + 200, ctrlY, currentPlayer != null && currentPlayer.isPlaying() ? "pause_fill" : "play_fill");
  drawPlayerIcon(artX + 290, ctrlY, "next_fill");
  drawPlayerIcon(artX + 380, ctrlY, "repeat");

  float volY = ctrlY + 60;
  drawPlayerIcon(artX + 20, volY, "vol_down");
  stroke(80);
  strokeWeight(4);
  line(artX + 50, volY, artX + 350, volY);
  stroke(255);
  line(artX + 50, volY, artX + 200, volY);
  drawPlayerIcon(artX + 380, volY, "vol_up");

  drawLyricsTemplate(700, height/2 - 100);
}

void drawLyricsTemplate(float lyrX, float startY) {
  String[] currentSongLyrics = allLyrics[0];
  if (selectedSong >= 0 && selectedSong < allLyrics.length) {
    currentSongLyrics = allLyrics[selectedSong];
  } else {
    currentSongLyrics = new String[]{"0", "Lirik tidak tersedia untuk lagu ini."};
  }

  int currentPos = (currentPlayer != null) ? currentPlayer.position() : 0;
  int activeIndex = 0;
  for (int i = 0; i < currentSongLyrics.length; i += 2) {
    if (currentPos >= Integer.parseInt(currentSongLyrics[i])) activeIndex = i;
  }

  targetLyricsScroll = - (activeIndex/2) * 80;
  lyricsScroll = lerp(lyricsScroll, targetLyricsScroll, 0.1);

  pushMatrix();
  float lyrY = startY + lyricsScroll;
  translate(lyrX, lyrY);

  for (int i = 0; i < currentSongLyrics.length; i += 2) {
    String lyricLine = currentSongLyrics[i+1];
    float ly = (i/2) * 80;

    float screenY = lyrY + ly;
    if (screenY < 50 || screenY > height - 50) continue;

    float distance = abs(ly + lyricsScroll);
    float opacity = map(distance, 0, 160, 255, 60);
    if (opacity < 60) opacity = 60;

    if (i == activeIndex) {
      fill(255, opacity);
      textSize(36);
      textFont(titleFont);
      textLeading(40);
      text(lyricLine, 0, ly, 450, 200);
    } else {
      fill(255, opacity * 0.5);
      textSize(28);
      textFont(titleFont);
      textLeading(32);
      text(lyricLine, 0, ly, 450, 200);
    }
  }
  popMatrix();
}

void drawPlayerIcon(float x, float y, String type) {
  pushMatrix();
  translate(x, y);
  stroke(255);
  strokeWeight(2);
  noFill();

  if (type.equals("star")) {
    beginShape();
    vertex(0, -10);
    vertex(3, -3);
    vertex(10, -3);
    vertex(4, 2);
    vertex(6, 9);
    vertex(0, 5);
    vertex(-6, 9);
    vertex(-4, 2);
    vertex(-10, -3);
    vertex(-3, -3);
    endShape(CLOSE);
  } else if (type.equals("prev_fill")) {
    fill(255);
    noStroke();
    triangle(0, -10, 0, 10, -12, 0);
    triangle(12, -10, 12, 10, 0, 0);
  } else if (type.equals("next_fill")) {
    fill(255);
    noStroke();
    triangle(-12, -10, -12, 10, 0, 0);
    triangle(0, -10, 0, 10, 12, 0);
  } else if (type.equals("play_fill")) {
    fill(255);
    noStroke();
    triangle(-8, -12, -8, 12, 12, 0);
  } else if (type.equals("pause_fill")) {
    fill(255);
    noStroke();
    rect(-8, -12, 6, 24, 2);
    rect(2, -12, 6, 24, 2);
  } else if (type.equals("airplay")) {
    stroke(255);
    noFill();
    arc(0, 5, 20, 20, PI + QUARTER_PI, TWO_PI - QUARTER_PI);
    arc(0, 8, 12, 12, PI + QUARTER_PI, TWO_PI - QUARTER_PI);
    arc(0, 11, 4, 4, PI + QUARTER_PI, TWO_PI - QUARTER_PI);
    fill(255);
    noStroke();
    triangle(-6, 12, 6, 12, 0, 4);
  } else if (type.equals("vol_down")) {
    fill(150);
    noStroke();
    triangle(-2, -4, -2, 4, -6, 0);
    rect(-6, -2, 4, 4);
  } else if (type.equals("vol_up")) {
    fill(150);
    noStroke();
    triangle(-2, -6, -2, 6, -8, 0);
    rect(-8, -3, 4, 6);
    stroke(150);
    noFill();
    arc(2, 0, 8, 8, -QUARTER_PI, QUARTER_PI);
    arc(2, 0, 14, 14, -QUARTER_PI, QUARTER_PI);
  } else if (type.equals("heart_small")) {
    noStroke();
    fill(0);
    float r = 3;
    ellipse(-r, -r, r*2.2, r*2.2);
    ellipse(r, -r, r*2.2, r*2.2);
    triangle(-r*2.1, -r*0.5, r*2.1, -r*0.5, 0, r*1.5);
  }
  popMatrix();
}

void drawIPodPlayer() {
  background(255);

  float s = 0.7; // Scale factor to make it smaller

  // iPod Body
  float ipodW = 850 * s;
  float ipodH = 480 * s;
  float centerX = width/2;
  float centerY = height/2;

  // Subtle outer shadow
  noStroke();
  fill(0, 20);
  rect(centerX - ipodW/2 + 5, centerY - ipodH/2 + 5, ipodW, ipodH, 50 * s);

  // Main Body (Silver/Metallic)
  fill(235);
  stroke(200);
  strokeWeight(1);
  rect(centerX - ipodW/2, centerY - ipodH/2, ipodW, ipodH, 45 * s);

  // Screen Area (Left side)
  float screenW = 450 * s;
  float screenH = 380 * s;
  float screenX = centerX - ipodW/2 + (35 * s);
  float screenY = centerY - screenH/2;

  // Screen Border
  fill(20);
  rect(screenX - (8*s), screenY - (8*s), screenW + (16*s), screenH + (16*s), 10 * s);

  // Screen Content (Soft Pinkish Gradient)
  for (int i = 0; i < screenH; i++) {
    float inter = map(i, 0, screenH, 0, 1);
    color c = lerpColor(color(255, 235, 240), color(255, 210, 220), inter);
    stroke(c);
    line(screenX, screenY + i, screenX + screenW, screenY + i);
  }

  // Album Art or Video (Only for songs 10 and 13)
  if (selectedSong == 10 && vidioAboutYou != null) {
    fill(255);
    rect(screenX + (40*s), screenY + (70*s), 200*s, 200*s, 5*s);
    image(vidioAboutYou, screenX + (50*s), screenY + (80*s), 180*s, 180*s);
  } else if (selectedSong == 13 && vidioMasaIni != null) {
    fill(255);
    rect(screenX + (40*s), screenY + (70*s), 200*s, 200*s, 5*s);
    image(vidioMasaIni, screenX + (50*s), screenY + (80*s), 180*s, 180*s);
  } else {

    PImage art = getSelectedImg();
    if (art != null) {
      fill(0, 30);
      noStroke();
      rect(screenX + (45*s), screenY + (75*s), 200*s, 200*s, 8*s);
      fill(255);
      rect(screenX + (40*s), screenY + (70*s), 200*s, 200*s, 5*s);
      image(art, screenX + (50*s), screenY + (80*s), 180*s, 180*s);
    }
  }

  // Metadata
  textAlign(LEFT, TOP);
  fill(0);
  textFont(titleFont); // Use title font for bolder look
  textSize(32 * s);
  if (selectedSong < songsList.length) {
    text(songsList[selectedSong], screenX + (260*s), screenY + (100*s), (170 * s), (150 * s));
  }
  fill(80);
  textFont(mainFont);
  textSize(18 * s);
  if (selectedSong < artistsList.length) text(artistsList[selectedSong], screenX + (260*s), screenY + (220*s));

  // Album Context Info
  fill(0, 100);
  textSize(12 * s);
  String albumLabel = "All Songs";
  if (playContext == 3 && selectedAlbumIndex < albumNames.length) albumLabel = albumNames[selectedAlbumIndex];
  else if (playContext == 1) albumLabel = "Liked Playlist";
  text("Playing from: " + albumLabel, screenX + (260*s), screenY + (250*s));

  // Progress Bar
  float barX = screenX + (40 * s);
  float barY = screenY + screenH - (60 * s);
  float barW = screenW - (80 * s);
  float progress = 0;
  String currentT = "0:00";
  String totalT = "0:00";

  if (currentPlayer != null && currentPlayer.length() > 0) {
    progress = (float)currentPlayer.position() / currentPlayer.length();
    int pos = currentPlayer.position() / 1000;
    int len = currentPlayer.length() / 1000;
    currentT = nf(pos/60, 1) + ":" + nf(pos%60, 2);
    totalT = nf(len/60, 1) + ":" + nf(len%60, 2);
  }

  stroke(0, 60);
  strokeWeight(4 * s);
  line(barX, barY, barX + barW, barY);
  stroke(0);
  strokeWeight(4 * s);
  line(barX, barY, barX + barW * smoothProgress, barY);
  fill(0);
  noStroke();
  ellipse(barX + barW * smoothProgress, barY, 12 * s, 12 * s);

  fill(0, 150);
  textSize(10 * s);
  textAlign(LEFT);
  text(currentT, barX, barY + (25 * s));
  textAlign(RIGHT);
  text(totalT, barX + barW, barY + (25 * s));

  // Heart icon on screen (Next to progress bar)
  float heartX = barX + barW;
  float heartY = barY - (15 * s);
  drawPlayerIcon(heartX, heartY, "heart_small");

  // Click Wheel (Right side)
  float wheelX = centerX + (230 * s);
  float wheelY = centerY;
  float wheelR = 300 * s;

  noStroke();
  fill(255);
  ellipse(wheelX, wheelY, wheelR, wheelR);

  // Hover Feedback for Wheel buttons
  textAlign(CENTER, CENTER);

  // MUSIC (on top of wheel)
  float menuY = wheelY - (110 * s);
  if (dist(mouseX, mouseY, wheelX, menuY) < (40 * s)) fill(230);
  else fill(200);
  textSize(22 * s);
  text("MUSIC", wheelX, menuY);

  // Prev
  float prevX = wheelX - (110 * s);
  boolean hoverPrev = dist(mouseX, mouseY, prevX, wheelY) < (40 * s);
  fill(hoverPrev ? 150 : 200);
  text("<<", prevX, wheelY);
  if (hoverPrev) {
    noFill();
    stroke(0, 30);
    ellipse(prevX, wheelY, 60*s, 60*s);
  }

  // Next
  float nextX = wheelX + (110 * s);
  boolean hoverNext = dist(mouseX, mouseY, nextX, wheelY) < (40 * s);
  fill(hoverNext ? 150 : 200);
  text(">>", nextX, wheelY);
  if (hoverNext) {
    noFill();
    stroke(0, 30);
    ellipse(nextX, wheelY, 60*s, 60*s);
  }

  // Play/Pause
  float playY = wheelY + (100 * s);
  boolean hoverPlay = dist(mouseX, mouseY, wheelX, playY + (10 * s)) < (40 * s);
  fill(hoverPlay ? 150 : 200);
  if (currentPlayer != null && currentPlayer.isPlaying()) {
    rect(wheelX - (6*s), playY, 4*s, 18*s);
    rect(wheelX + (2*s), playY, 4*s, 18*s);
  } else {
    triangle(wheelX - (8*s), playY, wheelX - (8*s), playY + 18*s, wheelX + 8*s, playY + 9*s);
  }
  if (hoverPlay) {
    noFill();
    stroke(0, 30);
    ellipse(wheelX, playY + 9*s, 60*s, 60*s);
  }

  // Center Button
  if (dist(mouseX, mouseY, wheelX, wheelY) < (50 * s)) fill(235);
  else fill(245);
  stroke(220);
  strokeWeight(1);
  ellipse(wheelX, wheelY, 100 * s, 100 * s);
}
void drawRetroText(String t, float x, float y, float sz) {
  drawRetroText(t, x, y, sz, color(20));
}

void drawRetroText(String t, float x, float y, float sz, color c) {
  textFont(retroFont);
  textSize(sz);
  textAlign(LEFT, TOP);

  // Retro Chunky Style
  fill(c);

  // We can simulate the distorted look by drawing layers or using charAt
  // Optimized Retro Text: only do character transformations if string is short
  if (t.length() > 20) {
    text(t, x, y);
    return;
  }

  float xOffset = 0;
  for (int i = 0; i < t.length(); i++) {
    char ch = t.charAt(i);
    float wave = sin(frameCount * 0.05 + i * 0.5) * 2;
    pushMatrix();
    translate(x + xOffset, y + wave);
    text(ch, 0, 0);
    popMatrix();
    xOffset += textWidth(ch) * 0.95;
  }
}

void drawBubblyText(String t, float x, float y, float sz) {
  textFont(bubblyFont);
  textSize(sz);
  textAlign(LEFT, TOP);

  // Optimized Bubbly Text: fewer outline layers
  fill(43, 27, 23);
  float out = 2.5;
  for (float a = 0; a < TWO_PI; a += PI/2) {
    text(t, x + cos(a)*out, y + sin(a)*out);
  }

  // 2. Main Body (Puffy Pink)
  fill(255, 170, 190);
  text(t, x, y);

  // 3. Inner Highlight (White)
  fill(255, 230);
  textSize(sz * 0.95);
  text(t, x - 1, y - 1);
}

void drawSearchResultsContent() {
  fill(textColor);
  textSize(28);
  text("Hasil Pencarian: " + searchQuery, 280, 70);
  stroke(subTextColor, 50);
  line(280, 100, width - 150, 100);

  if (searchResultIndices.isEmpty()) {
    fill(subTextColor);
    textSize(16);
    text("Tidak ada lagu yang ditemukan untuk '" + searchQuery + "'", 280, 200);
    return;
  }

  for (int i = 0; i < searchResultIndices.size(); i++) {
    int sIdx = searchResultIndices.get(i);
    float y = 180 + i * 55;

    if (sIdx == selectedSong) {
      fill(accentColor, 50);
    } else if (mouseY > y - 25 && mouseY < y + 30 && mouseX > 280 && mouseX < width - 150) {
      fill(255, 100);
    } else {
      noFill();
    }
    noStroke();
    rect(280, y-25, width - 430, 50, 10);

    if (sIdx < imgsList.length && imgsList[sIdx] != null) image(imgsList[sIdx], 310, y - 15, 30, 30);

    fill(sIdx == selectedSong ? accentColor : textColor);
    textSize(15);
    text(i + 1, 285, y + 5);
    text(songsList[sIdx], 350, y + 5);
    fill(subTextColor);
    textSize(11);
    text("Artis: " + artistsList[sIdx], 350, y + 22);

    int len = 0;
    if (players[sIdx] != null) len = players[sIdx].length() / 1000;
    String dur = nf(len/60, 1) + ":" + nf(len%60, 2);
    fill(sIdx == selectedSong ? accentColor : textColor);
    text(dur, width - 250, y + 5);
  }
}

void keyTyped() {
  if (searchFocused) {
    if (key == BACKSPACE) {
      if (searchQuery.length() > 0) searchQuery = searchQuery.substring(0, searchQuery.length()-1);
    } else if (key == ENTER || key == RETURN) {
      searchFocused = false;
    } else if (key != CODED) {
      searchQuery += key;
    }

    // Update Search Results
    searchResultIndices.clear();
    if (searchQuery.length() > 0) {
      currentPage = 8;
      String q = searchQuery.toLowerCase();
      for (int i = 0; i < songsList.length; i++) {
        if (songsList[i].toLowerCase().contains(q) || artistsList[i].toLowerCase().contains(q)) {
          searchResultIndices.add(i);
        }
      }
    } else {
      currentPage = 0;
    }
  }
}

void drawStar(float x, float y, float radius1, float radius2, int npoints) {
  float angle = TWO_PI / npoints;
  float halfAngle = angle/2.0;
  beginShape();
  for (float a = -HALF_PI; a < TWO_PI - HALF_PI; a += angle) {
    float sx = x + cos(a) * radius2;
    float sy = y + sin(a) * radius2;
    vertex(sx, sy);
    sx = x + cos(a + halfAngle) * radius1;
    sy = y + sin(a + halfAngle) * radius1;
    vertex(sx, sy);
  }
  endShape(CLOSE);
}

// =============================================
// UPDATE CONTROLS: Handle Seek & Volume
// =============================================
void updateControls(float mx, float my) {
  if (currentPlayer == null) return;

  // --- Volume Slider (Bottom Bar) ---
  if (currentPage != 6 && currentPage != 7) {
    float barY = height - 45;
    float contentX = 280;
    float contentW = width - 380;
    float volX = contentX + contentW - 60;
    float controlY = barY + 30;
    if (controlY > height - 10) controlY = height - 15;

    if (mx >= volX && mx <= volX + 60 && my >= controlY - 10 && my <= controlY + 10) {
      isDraggingVol = true;
      volumeValue = constrain((mx - volX) / 60.0, 0, 1);
      // Minim volume is usually -80 to 6 or similar, but setGain/setVolume varies
      float gain = map(volumeValue, 0, 1, -40, 10);
      currentPlayer.setGain(gain);
    }
  }

  // --- Seek Logic (Scrubbing) ---
  if (currentPlayer.length() == 0) return;

  // iPod Player Seek
  if (currentPage == 7) {
    float s = 0.7;
    float centerX = width/2;
    float centerY = height/2;
    float screenW = 450 * s;
    float screenH = 380 * s;
    float screenX = centerX - (850*s)/2 + (35*s);
    float screenY = centerY - screenH/2;
    float barX = screenX + (40*s);
    float barY = screenY + screenH - (60*s);
    float barW = screenW - (80*s);
    if (mx >= barX && mx <= barX + barW && my >= barY - 20 && my <= barY + 20) {
      isDraggingSeek = true;
      currentPlayer.cue((int)map(mx, barX, barX + barW, 0, currentPlayer.length()));
    }
  }
  // Full Screen Player Seek
  else if (currentPage == 5) {
    float ww = 800;
    float wh = 450;
    float wx = 250 + (width - 250 - ww)/2;
    float wy = (height - wh)/2;
    float barY = wy + 30 + 140;
    float barX = wx + 450 + 40;
    if (mx >= barX && mx <= barX + 230 && my >= barY - 15 && my <= barY + 15) {
      isDraggingSeek = true;
      currentPlayer.cue((int)map(mx, barX, barX + 230, 0, currentPlayer.length()));
    }
  }
  // Preview Panel Seek
  else if (currentPage == 0 || currentPage == 1 || currentPage == 4) {
    float pvX = 740;
    float pvY = 100 + uiOffset * 1.5;
    float ctrlY = pvY + 500;
    if (mx >= pvX && mx <= pvX + 400 && my >= ctrlY - 15 && my <= ctrlY + 15) {
      isDraggingSeek = true;
      currentPlayer.cue((int)map(mx, pvX, pvX + 400, 0, currentPlayer.length()));
    }
  }
  // Bottom Bar Seek
  if (currentPage != 6 && currentPage != 7) {
    float barY = height - 45;
    float contentX = 280;
    float contentW = width - 380;
    if (mx >= contentX && mx <= contentX + contentW && my >= barY - 15 && my <= barY + 15) {
      isDraggingSeek = true;
      currentPlayer.cue((int)map(mx, contentX, contentX + contentW, 0, currentPlayer.length()));
    }
  }
}

void mouseDragged() {
  if (isDraggingSeek || isDraggingVol) {
    updateControls(mouseX, mouseY);
  }
}

void mouseReleased() {
  isDraggingSeek = false;
  isDraggingVol = false;
}

void drawSplashScreen() {
  splashTimer++;

  // 1. New Premium Background
  if (splashImgNew != null) {
    image(splashImgNew, 0, 0, width, height);
  } else {
    background(20, 10, 30); // Fallback dark purple
  }

  // 2. Animated Butterflies and Particles
  for (int i = 0; i < 8; i++) {
    // Wander path for butterflies
    float bx = (noise(i * 100, frameCount * 0.003) * width * 1.2) - width * 0.1;
    float by = (noise(i * 100 + 50, frameCount * 0.003) * height * 1.2) - height * 0.1;
    float bSz = 15 + noise(i * 20) * 15;
    float bFlap = 0.1 + noise(i) * 0.2;
    drawButterfly(bx, by, bSz, bFlap);
  }

  // Subtle Glow Dust
  for (int i = 0; i < 15; i++) {
    float x = (noise(i, frameCount * 0.005) * width);
    float y = (noise(i + 10, frameCount * 0.005) * height);
    float sz = noise(i + 20, frameCount * 0.01) * 3;
    fill(255, 120 + sin(frameCount * 0.05 + i) * 80);
    noStroke();
    ellipse(x, y, sz, sz);
  }

  // 3. "by.nicaa" Top Label (Groovy/Retro style like template)
  pushMatrix();
  float labelSz = 24;
  textFont(retroFont);
  textSize(labelSz);
  float labelW = textWidth("by.nicaa");
  translate(width/2 - labelW/2, 170); // Center the label
  drawRetroText("by.nicaa", 0, 0, labelSz, accentColor);
  popMatrix();

  // 4. "MUSICA" Title with Glow at the Bottom
  pushMatrix();
  float titleY = height - 180;
  translate(width/2, titleY);

  // Transition Out
  float exitAlpha = 255;
  if (splashTimer > 280) {
    exitAlpha = map(splashTimer, 280, 300, 255, 0);
  }

  // High-speed Sequential Letter Animation
  String fullText = "MUSICA";
  textFont(eleganceFont);
  textSize(120);

  // Calculate total width to center the text
  float totalWidth = textWidth(fullText);
  float startX = -totalWidth / 2;
  float currentX = startX;

  for (int i = 0; i < fullText.length(); i++) {
    char c = fullText.charAt(i);
    float charW = textWidth(c);

    // Animation timing for each letter (fast sequential reveal)
    float charDelay = i * 4; // Delay per letter
    float charDuration = 12.0; // Duration of individual letter animation
    float tChar = constrain((splashTimer - charDelay) / charDuration, 0, 1);
    float easeChar = 1 - pow(1 - tChar, 4); // Quartic Ease Out

    if (tChar > 0) {
      pushMatrix();
      // Move to character position
      float waveOffset = sin(frameCount * 0.1 + i * 0.5) * 10;
      translate(currentX + charW/2, waveOffset);

      // Individual letter animation (scale and fade)
      scale(lerp(0.5, 1.0, easeChar));
      float charAlpha = lerp(0, 255, easeChar) * (exitAlpha / 255.0);

      // --- BUBBLY RETRO EFFECT (Funky Style) ---
      textAlign(CENTER, CENTER);

      // 1. Thick Outer Outline (Retro Shadow)
      fill(40, 20, 60, charAlpha); // Dark purple shadow
      float outlineSize = 6.0;
      for (float a = 0; a < TWO_PI; a += PI/4) {
        text(c, cos(a) * outlineSize, sin(a) * outlineSize);
      }

      // 2. Main Puffy Body
      fill(255, 150, 200, charAlpha); // Puffy Pink
      text(c, 0, 0);

      // 3. Inner Gloss/Highlight
      fill(255, 255, 255, charAlpha * 0.8);
      textSize(110);
      text(c, -3, -5);
      textSize(120);

      popMatrix();
    }
    currentX += charW;
  }
  popMatrix();

  // 5. Secondary Details (Decorative)



  textSize(16);
  text("01.", width - 120, height - 100);

  // Bottom Center Instruction
  textFont(mainFont);
  fill(255, 180 * (exitAlpha / 255.0));
  text("Double click to enter the music world", width/2, height - 40);

  // Auto transition
  if (splashTimer > 300) {
    currentPage = 0;
  }
}


void drawProfileScreen() {
  // Video Background for Profile (Only for songs 10 and 13)
  if (selectedSong == 10 && vidioAboutYou != null) {
    imageMode(CORNER);
    image(vidioAboutYou, 0, 0, width, height);
  } else if (selectedSong == 13 && vidioMasaIni != null) {
    imageMode(CORNER);
    image(vidioMasaIni, 0, 0, width, height);
  } else if (profileTemplateImg != null) {
    imageMode(CORNER);
    image(profileTemplateImg, 0, 0, width, height);
  } else {
    background(0);
    fill(255);
    textAlign(CENTER, CENTER);
    textSize(24);
    text("Template Profil Tidak Ditemukan", width/2, height/2);
    textAlign(LEFT, TOP);
  }

  // Tombol kembali virtual di pojok kiri atas
  fill(255, 150);
  noStroke();
  rect(30, 30, 110, 40, 20);
  fill(textColor);
  textSize(16);
  text("< Kembali", 45, 42);
}

void drawLyricsScreen() {
  pushStyle();
  background(0); // Pure black background before video

  // Background: Video (For songs 10 and 13) or Blurred Art
  if (selectedSong == 10 && vidioAboutYou != null) {
    imageMode(CORNER);
    image(vidioAboutYou, 0, 0, width, height);
  } else if (selectedSong == 13 && vidioMasaIni != null) {
    imageMode(CORNER);
    image(vidioMasaIni, 0, 0, width, height);
  } else if (selectedSong >= 0 && selectedSong < imgsList.length && imgsList[selectedSong] != null) {
    imageMode(CORNER);
    tint(255, 80);
    image(imgsList[selectedSong], 0, 0, width, height);
    noTint();
  }

  // Dark overlay with gradient feel
  if (selectedSong != 10 && selectedSong != 14 && selectedSong != 12 && selectedSong != 13) {
    for (int i=0; i<height; i+=2) {
      float alpha = map(i, 0, height, 180, 240);
      stroke(10, alpha);
      line(0, i, width, i);
    }
  } else {
    // Add a very subtle dark tint so lyrics are readable without scanlines
    fill(0, 80);
    noStroke();
    rect(0, 0, width, height);
  }

  float leftW = width * 0.45;
  float artSize = (leftW - 100) * 0.7; // Diperkecil
  float artX = (leftW - artSize) / 2; // Diletakkan di tengah
  float artY = 120;

  // --- LEFT SIDE: Player ---
  // Album Art
  if (selectedSong >= 0 && selectedSong < imgsList.length && imgsList[selectedSong] != null) {
    image(imgsList[selectedSong], artX, artY, artSize, artSize);
    noFill();
    stroke(255, 30);
    rect(artX, artY, artSize, artSize, 15);
  }

  // Song Info
  fill(255);
  textFont(titleFont);
  textSize(24);
  textAlign(CENTER, TOP);
  text(songsList[selectedSong], artX + artSize/2, artY + artSize + 25);

  fill(255, 180);
  textFont(mainFont);
  textSize(15);
  text(artistsList[selectedSong], artX + artSize/2, artY + artSize + 55);
  textAlign(LEFT, TOP);

  // Progress Bar
  float ctrlY = artY + artSize + 130;
  float barW = artSize;
  stroke(255, 50);
  strokeWeight(4);
  line(artX, ctrlY - 55, artX + barW, ctrlY - 55);

  float progress = 0;
  if (currentPlayer != null && currentPlayer.length() > 0) progress = (float)currentPlayer.position() / currentPlayer.length();
  stroke(255);
  line(artX, ctrlY - 55, artX + barW * progress, ctrlY - 55);

  // Time
  fill(255, 150);
  textSize(12);
  int pos = (currentPlayer != null) ? currentPlayer.position() / 1000 : 0;
  int len = (currentPlayer != null) ? currentPlayer.length() / 1000 : 0;
  text(nf(pos/60, 1) + ":" + nf(pos%60, 2), artX, ctrlY - 40);
  textAlign(RIGHT);
  text("-" + nf((len-pos)/60, 1) + ":" + nf((len-pos)%60, 2), artX + barW, ctrlY - 40);

  // Controls
  textAlign(CENTER, CENTER);
  float cx = artX + artSize/2;

  // Shuffle
  drawIconModern(cx - 140, ctrlY, "shuffle", isShuffle);
  // Prev
  drawIconModern(cx - 80, ctrlY, "prev", false);
  // Play/Pause Circle
  fill(255);
  noStroke();
  ellipse(cx, ctrlY, 70, 70);
  fill(0);
  if (currentPlayer != null && currentPlayer.isPlaying()) {
    rect(cx - 6, ctrlY - 10, 4, 20);
    rect(cx + 2, ctrlY - 10, 4, 20);
  } else {
    triangle(cx - 5, ctrlY - 12, cx - 5, ctrlY + 12, cx + 12, ctrlY);
  }
  // Next
  drawIconModern(cx + 80, ctrlY, "next", false);
  // Repeat
  drawIconModern(cx + 140, ctrlY, "repeat", isRepeat);

  // Volume Slider
  float volY = ctrlY + 70;
  drawIconModern(artX + 30, volY, "vol_low", false);
  stroke(255, 50);
  line(artX + 50, volY, artX + artSize - 50, volY);
  stroke(255, 180);
  line(artX + 50, volY, artX + 50 + (artSize - 100) * volumeValue, volY);
  fill(255);
  noStroke();
  ellipse(artX + 50 + (artSize - 100) * volumeValue, volY, 12, 12);
  drawIconModern(artX + artSize - 30, volY, "vol_high", false);

  // --- RIGHT SIDE: Lyrics ---
  float rightX = leftW + 50;
  float rightW = width - rightX - 50;

  // Extract only the text parts from allLyrics (index 1, 3, 5...)
  String[] rawLyrics = (selectedSong >= 0 && selectedSong < allLyrics.length) ? allLyrics[selectedSong] : null;
  ArrayList<String> linesList = new ArrayList<String>();
  if (rawLyrics != null && rawLyrics.length > 1) {
    for (int i = 1; i < rawLyrics.length; i += 2) {
      linesList.add(rawLyrics[i]);
    }
  } else {
    linesList.add("Lirik tidak tersedia.");
  }

  // Sync logic: Find active index based on timestamps
  int currentPos = (currentPlayer != null) ? currentPlayer.position() : 0;
  int activeIndex = 0;
  if (rawLyrics != null && rawLyrics.length > 1) {
    for (int i = 0; i < rawLyrics.length; i += 2) {
      if (currentPos >= Integer.parseInt(rawLyrics[i])) activeIndex = i;
    }
  }

  // Smooth scroll logic
  targetLyricsScroll = - (activeIndex/2) * 60;
  lyricsScroll = lerp(lyricsScroll, targetLyricsScroll, 0.1);

  float lyricY = height/2;
  textAlign(LEFT, CENTER);

  for (int i = 0; i < linesList.size(); i++) {
    String lineText = linesList.get(i);
    float y = lyricY + (i * 60) + lyricsScroll;

    // Check visibility and calculate opacity based on distance from center
    float distToCenter = abs(y - height/2);
    float alpha = map(distToCenter, 0, 200, 255, 0);
    alpha = constrain(alpha, 0, 255);

    if (i == activeIndex/2) {
      fill(255, alpha);
      textSize(36);
      textFont(titleFont);
    } else {
      fill(255, alpha * 0.4);
      textSize(26);
      textFont(mainFont);
    }

    if (y > 50 && y < height - 50) {
      text(lineText, rightX, y, rightW, 100);
    }
  }

  // Back button (Top Left)
  textAlign(LEFT, CENTER);
  fill(255, 150);
  rect(30, 30, 100, 40, 20);
  fill(255);
  textSize(14);
  text("< Kembali", 45, 50);

  popStyle();
}

void drawIconModern(float x, float y, String type, boolean active) {
  pushStyle();
  stroke(active ? accentColor : color(255, 180));
  strokeWeight(2);
  noFill();
  pushMatrix();
  translate(x, y);

  if (type.equals("shuffle")) {
    line(-10, -5, 10, 5);
    line(-10, 5, 10, -5);
  } else if (type.equals("repeat")) {
    ellipse(0, 0, 15, 12);
    triangle(5, -6, 10, -6, 7.5, -3);
  } else if (type.equals("prev")) {
    triangle(5, -8, 5, 8, -5, 0);
    line(-7, -8, -7, 8);
  } else if (type.equals("next")) {
    triangle(-5, -8, -5, 8, 5, 0);
    line(7, -8, 7, 8);
  } else if (type.equals("vol_low")) {
    textSize(10);
    fill(255, 150);
    textAlign(CENTER, CENTER);
    text("Vol-", 0, 0);
  } else if (type.equals("vol_high")) {
    textSize(10);
    fill(255, 150);
    textAlign(CENTER, CENTER);
    text("Vol+", 0, 0);
  }

  popMatrix();
  popStyle();
}

// --- NEW: Ethereal Purple Butterfly Animation Function ---
void drawButterfly(float x, float y, float sz, float flapSpeed) {
  if (butterflyCache == null) return;
  pushMatrix();
  translate(x, y);

  // Animation logic
  float flap = sin(frameCount * flapSpeed);
  float wingScale = map(abs(flap), 0, 1, 0.1, 1.0);

  // Gentle body tilt/wobble
  rotate(sin(frameCount * 0.03) * 0.4);
  
  imageMode(CENTER);
  pushMatrix();
  scale(wingScale, 1.0);
  image(butterflyCache, 0, 0, sz * 2.5, sz * 2.5);
  popMatrix();
  imageMode(CORNER);

  popMatrix();
}

// --- NEW: Purple Chrome Sparkle Effect for Text Tips ---
void drawPurpleSparkle(float x, float y, float alpha) {
  pushMatrix();
  translate(x, y);

  // Rotate slowly
  rotate(frameCount * 0.12);

  stroke(255, alpha);
  strokeWeight(2);
  // Sharp cross
  line(-15, 0, 15, 0);
  line(0, -15, 0, 15);

  // Diagonal sharp points
  strokeWeight(1);
  line(-8, -8, 8, 8);
  line(8, -8, -8, 8);

  // Center glow
  noStroke();
  fill(255, alpha);
  ellipse(0, 0, 4, 4);
  fill(150, 50, 255, alpha * 0.6);
  ellipse(0, 0, 15, 15);

  popMatrix();
}

void drawKaraukeContent() {
  // Title moved down to avoid overlap with header search bar
  drawRetroText("fav memories", 280, 100, 64);

  // Microphone/Lightstick Icon (Top Right) - Styled like template
  float micX = width - 100;
  float micY = 100;
  fill(accentColor);
  ellipse(micX, micY, 60, 60);
  fill(255);
  rect(micX - 10, micY - 20, 20, 40, 10); // Lightstick head
  fill(textColor, 150);
  rect(micX - 4, micY + 15, 8, 15); // handle

  float lx = 300;
  float ly = 180;
  float lw = width - 350;
  float lh = height - 300;

  // --- VIDEO BACKGROUND (if toggled) ---
  if (showVideoMomen) {
    pushStyle();
    float tx = lx - 20;
    float ty = ly + 40;
    float tw = lw + 40;
    float th = lh - 10;

    color bgPink = color(251, 228, 228);
    color tabPink = color(214, 162, 162);
    color darkOutline = color(50, 20, 20);
    color fillDarkPink = color(232, 197, 197);

    // 1. BACK WINDOW
    float bx = tx + tw - 50;
    float by = ty - 60;
    float bw = 150; // narrower so it doesn't go off screen
    float bh = th + 40;

    stroke(darkOutline);
    strokeWeight(3);
    fill(bgPink);
    rect(bx, by, bw, bh, 5);

    // Back window header
    fill(bgPink);
    rect(bx, by, bw, 35, 5, 5, 0, 0);
    line(bx, by + 35, bx + bw, by + 35);

    // Back window Mac buttons (circles)
    fill(bgPink);
    ellipse(bx + bw - 20, by + 17, 10, 10);
    ellipse(bx + bw - 40, by + 17, 10, 10);
    ellipse(bx + bw - 60, by + 17, 10, 10);

    // Back window side bars
    for (int i=0; i<6; i++) {
      fill(tabPink);
      rect(bx + bw - 35, by + 60 + i*40, 25, 15, 10);
    }

    // 2. FRONT WINDOW
    float tabW = 250;
    float tabH = 35;

    // Main Window Body
    stroke(darkOutline);
    strokeWeight(3);
    fill(bgPink);
    rect(tx, ty, tw, th, 5);

    // Address bar area (Header)
    float headerY = ty;
    float headerH = 50;

    fill(bgPink);
    rect(tx, headerY, tw, headerH, 5, 5, 0, 0);
    line(tx, headerY + headerH, tx + tw, headerY + headerH);

    // Inner pink bar
    fill(tabPink);
    rect(tx + 2, headerY + 2, tw - 4, headerH - 12, 5, 5, 0, 0);

    // Left/Right arrows
    fill(darkOutline);
    noStroke();
    triangle(tx + 20, headerY + 20, tx + 30, headerY + 12, tx + 30, headerY + 28);
    triangle(tx + 45, headerY + 20, tx + 35, headerY + 12, tx + 35, headerY + 28);
    stroke(darkOutline);
    strokeWeight(2);
    line(tx + 20, headerY + 20, tx + 30, headerY + 20);
    line(tx + 45, headerY + 20, tx + 35, headerY + 20);

    // Address pill
    fill(fillDarkPink);
    stroke(darkOutline);
    strokeWeight(2);
    rect(tx + 65, headerY + 5, tw - 130, 28, 14);

    // Heart Icon
    fill(150, 70, 70);
    noStroke();
    pushMatrix();
    translate(tx + tw - 35, headerY + 12);
    scale(0.8);
    beginShape();
    vertex(0, 15);
    bezierVertex(0, 0, -20, 0, -20, 10);
    bezierVertex(-20, 25, 0, 30, 0, 30);
    bezierVertex(0, 30, 20, 25, 20, 10);
    bezierVertex(20, 0, 0, 0, 0, 15);
    endShape();
    popMatrix();

    // 3. FRONT WINDOW TAB (Drawn over the top outline)
    fill(bgPink);
    stroke(darkOutline);
    strokeWeight(3);
    beginShape();
    vertex(tx, ty + 2); // To cover outline
    vertex(tx, ty - tabH);
    quadraticVertex(tx, ty - tabH - 5, tx + 5, ty - tabH - 5);
    vertex(tx + tabW - 20, ty - tabH - 5);
    quadraticVertex(tx + tabW, ty - tabH - 5, tx + tabW + 5, ty + 2);
    endShape(CLOSE);
    // hide bottom line of tab
    noStroke();
    fill(tabPink);
    rect(tx + 2, ty - 2, tabW + 2, 6);
    fill(bgPink);
    rect(tx + 2, ty - tabH + 2, tabW - 10, tabH - 2);

    // Strawberry icon
    pushMatrix();
    translate(tx + 30, ty - tabH + 15);
    noStroke();
    fill(200, 80, 80);
    bezier(-8, -6, -15, 10, 15, 10, 8, -6);
    fill(80, 150, 80);
    triangle(-5, -6, 5, -6, 0, -12);
    popMatrix();

    // 'x' on tab
    stroke(darkOutline);
    strokeWeight(2);
    line(tx + tabW - 20, ty - tabH + 12, tx + tabW - 10, ty - tabH + 22);
    line(tx + tabW - 10, ty - tabH + 12, tx + tabW - 20, ty - tabH + 22);

    // 4. RIGHT SCROLLBAR AREA
    float sbW = 30;
    float sbX = tx + tw - sbW;
    stroke(darkOutline);
    strokeWeight(3);
    line(sbX, headerY + headerH, sbX, ty + th);

    // Scroll handle
    fill(tabPink);
    rect(sbX + 5, headerY + headerH + 30, 20, 100, 10);

    // Video Content Area
    float cx = tx + 15;
    float cy = headerY + headerH + 15;
    float cw = tw - sbW - 30;
    float ch = th - headerH - 30;

    if (vidioMomen != null) {
      if (vidioMomen.width > 0) {
        // Draw Video
        image(vidioMomen, cx, cy, cw, ch);

        // Outline for video
        noFill();
        stroke(darkOutline);
        strokeWeight(2);
        rect(cx, cy, cw, ch);

        // --- OVERLAY PLAYBACK CONTROLS ---
        if (showMomenControls) {
          pushStyle();
          float ctrlW = 350;
          float ctrlH = 80;
          float ctrlX = cx + cw/2 - ctrlW/2;
          float ctrlY = cy + ch - ctrlH - 20;

          // Playback Control Container
          stroke(170, 190, 230); // Light blue border
          strokeWeight(4);
          fill(255); // White background
          rect(ctrlX, ctrlY, ctrlW, ctrlH, 15);

          // Progress Bar (Pink)
          noStroke();
          fill(243, 164, 199); // Pink #F3A4C7
          rect(ctrlX + 30, ctrlY + 20, ctrlW - 60, 6, 3);

          // Control Buttons
          float btnY = ctrlY + 50;

          // Rewind Icon
          fill(243, 164, 199);
          triangle(ctrlX + 110, btnY - 8, ctrlX + 110, btnY + 8, ctrlX + 95, btnY);
          triangle(ctrlX + 125, btnY - 8, ctrlX + 125, btnY + 8, ctrlX + 110, btnY);
          rect(ctrlX + 90, btnY - 8, 3, 16);

          // Play / Pause Icon
          fill(166, 188, 225); // Light Blue #A6BCE1
          if (isPlayingMomen) {
            rect(ctrlX + ctrlW/2 - 8, btnY - 12, 6, 24);
            rect(ctrlX + ctrlW/2 + 2, btnY - 12, 6, 24);
          } else {
            triangle(ctrlX + ctrlW/2 - 6, btnY - 14, ctrlX + ctrlW/2 - 6, btnY + 14, ctrlX + ctrlW/2 + 14, btnY);
          }

          // Fast Forward Icon
          fill(243, 164, 199);
          triangle(ctrlX + ctrlW - 110, btnY - 8, ctrlX + ctrlW - 110, btnY + 8, ctrlX + ctrlW - 95, btnY);
          triangle(ctrlX + ctrlW - 125, btnY - 8, ctrlX + ctrlW - 125, btnY + 8, ctrlX + ctrlW - 110, btnY);
          rect(ctrlX + ctrlW - 93, btnY - 8, 3, 16);

          // Left Decorative Flower
          pushMatrix();
          translate(ctrlX - 5, ctrlY + 25);
          fill(243, 164, 199); // Pink petals
          for (int i = 0; i < 5; i++) {
            ellipse(0, -6, 8, 8);
            rotate(TWO_PI / 5);
          }
          fill(255, 217, 102); // Yellow center
          ellipse(0, 0, 8, 8);
          popMatrix();

          // Left Decorative Heart
          pushMatrix();
          translate(ctrlX - 25, ctrlY + 60);
          fill(253, 221, 228); // Light pink heart
          beginShape();
          vertex(0, 4);
          bezierVertex(0, -4, -12, -4, -12, 0);
          bezierVertex(-12, 6, 0, 12, 0, 12);
          bezierVertex(0, 12, 12, 6, 12, 0);
          bezierVertex(12, -4, 0, -4, 0, 4);
          endShape();
          popMatrix();

          // Left Top Decorative Star
          pushMatrix();
          translate(ctrlX - 20, ctrlY - 5);
          stroke(255, 217, 102);
          strokeWeight(2);
          noFill();
          line(-6, 0, 6, 0);
          line(0, -6, 0, 6);
          line(-4, -4, 4, 4);
          line(4, -4, -4, 4);
          popMatrix();

          // Right Decorative Flower
          pushMatrix();
          translate(ctrlX + ctrlW + 10, ctrlY + 65);
          noStroke();
          fill(243, 164, 199); // Pink petals
          for (int i = 0; i < 5; i++) {
            ellipse(0, -8, 10, 10);
            rotate(TWO_PI / 5);
          }
          fill(255, 217, 102); // Yellow center
          ellipse(0, 0, 10, 10);
          popMatrix();

          // Right Decorative Heart
          pushMatrix();
          translate(ctrlX + ctrlW + 25, ctrlY + 20);
          fill(253, 221, 228); // Light pink heart
          beginShape();
          vertex(0, 4);
          bezierVertex(0, -4, -10, -4, -10, 0);
          bezierVertex(-10, 5, 0, 10, 0, 10);
          bezierVertex(0, 10, 10, 5, 10, 0);
          bezierVertex(10, -4, 0, -4, 0, 4);
          endShape();
          popMatrix();

          // Right Bottom Decorative Star
          pushMatrix();
          translate(ctrlX + ctrlW + 25, ctrlY + 85);
          stroke(255, 217, 102);
          strokeWeight(2);
          noFill();
          line(-5, 0, 5, 0);
          line(0, -5, 0, 5);
          line(-3, -3, 3, 3);
          line(3, -3, -3, 3);
          popMatrix();

          popStyle();
        }
      } else {
        fill(0, 30);
        rect(cx, cy, cw, ch, 5);
        fill(darkOutline);
        textAlign(CENTER, CENTER);
        text("Loading Video...", cx + cw/2, cy + ch/2);
        textAlign(LEFT, TOP);
      }
    }

    popStyle();
  } else {
    // --- DEFAULT VIEW (Video Off) ---
    // Glass Body
    noStroke();
    fill(255, 120);
    rect(lx, ly, lw, lh, 40);

    if (bingkaiImg != null) {
      image(bingkaiImg, lx, ly, lw, lh);
    }

    // Decorative Floating Music Notes (Simplified to match template)
    for (int i = 0; i < 6; i++) {
      float nx = lx + 100 + i * (lw/7);
      float ny = ly + 60 + sin(frameCount * 0.04 + i) * 15;
      drawMiniMusicNote(nx, ny, i % 2 == 0);
    }

    textAlign(CENTER, CENTER);

    // --- BARIS 1 (Small, Dark/White if video) ---
    fill(textColor);
    textFont(titleFont);
    textSize(28);
    text("He was just a shape...", lx + lw/2, ly + lh/2 - 70);

    // --- BARIS 2 (Chunky Pink) ---
    float tx_text = lx + lw/2;
    float ty_text = ly + lh/2;

    textFont(retroFont);
    textSize(58);

    // Chunky Shadow Effect
    fill(0, 50);
    text("Of my heart", tx_text + 2, ty_text + 2);

    fill(accentColor);
    text("Of my heart", tx_text, ty_text);

    fill(subTextColor);
    textFont(mainFont);
    textSize(22);
    text("Here are the memories!", lx + lw/2, ly + lh - 70);

    textAlign(LEFT, TOP);
  }
}

// Helper to draw aesthetic musical notes (Simplified Hand-drawn style)
void drawMiniMusicNote(float x, float y, boolean type) {
  pushMatrix();
  translate(x, y);
  rotate(sin(frameCount * 0.02) * 0.1);

  stroke(accentColor, 120);
  strokeWeight(2);
  noFill();

  // Note Head
  fill(accentColor, 80);
  ellipse(0, 0, 10, 8);

  // Stem
  line(4, 0, 4, -20);

  // Flag
  if (type) {
    bezier(4, -20, 8, -18, 12, -15, 10, -8);
  } else {
    // Double note feel
    line(4, -20, 12, -18);
    ellipse(8, 2, 10, 8);
    line(12, 2, 12, -18);
  }

  popMatrix();
}  
